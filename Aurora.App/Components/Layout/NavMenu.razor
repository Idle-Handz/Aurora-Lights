@implements IDisposable
@inject CharacterTabService Tabs
@inject UserPreferencesService Prefs
@inject DebugLogService DebugLog
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@using Aurora.App.Components.Pages

<MudNavMenu>
    @* ── Global ── *@
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.People">
        Characters
    </MudNavLink>
    <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings">
        Settings
    </MudNavLink>
    <MudNavLink Href="/compendium" Icon="@Icons.Material.Filled.MenuBook">
        Compendium
    </MudNavLink>
    @if (Prefs.DevMode)
    {
        <MudNavLink Href="/content-doctor" Icon="@Icons.Material.Filled.HealthAndSafety">
            Content Doctor
        </MudNavLink>
        <MudNavLink Href="/console" Icon="@Icons.Material.Filled.Terminal">
            Console
            @if (DebugLog.Entries.Any(e => e.Level == LogLevel.Error))
            {
                <span class="nav-error-indicator">●</span>
            }
        </MudNavLink>
    }

    @* ── Per-character (only shown when a character is open) ── *@
    @if (Tabs.ActiveTab != null)
    {
        bool _loading = Tabs.ActiveTab.IsLoading;
        <MudDivider Class="my-2" />
        @if (_loading)
        {
            <div class="nav-loading-row">
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary"
                                     Style="width: 14px; height: 14px;" />
                <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">Loading character…</MudText>
            </div>
        }
        <MudTooltip Text="@(_loading ? "Loading character…" : "")" Placement="Placement.Right" Delay="300" Style="display:block">
            <MudNavLink Href="/character" Icon="@Icons.Material.Filled.Person" Disabled="_loading">
                Overview
            </MudNavLink>
        </MudTooltip>
        <MudNavLink Href="/build" Icon="@Icons.Material.Filled.Build">
            Build
        </MudNavLink>
        <MudTooltip Text="@(_loading ? "Loading character…" : "")" Placement="Placement.Right" Delay="300" Style="display:block">
            <MudNavLink Href="/equipment" Icon="@Icons.Material.Filled.Shield" Disabled="_loading">
                Equipment
            </MudNavLink>
        </MudTooltip>
        <MudTooltip Text="@(_loading ? "Loading character…" : "")" Placement="Placement.Right" Delay="300" Style="display:block">
            <MudNavLink Href="/shop" Icon="@Icons.Material.Filled.Storefront" Disabled="_loading">
                Shop
            </MudNavLink>
        </MudTooltip>
        <MudTooltip Text="@(_loading ? "Loading character…" : "")" Placement="Placement.Right" Delay="300" Style="display:block">
            <MudNavLink Href="/session" Icon="@Icons.Material.Filled.Favorite" Disabled="_loading">
                Session
            </MudNavLink>
        </MudTooltip>
        @if (SidekickService.HasCompanions(Tabs.ActiveTab))
        {
            int pendingSidekicks = SidekickService.CountSidekicksNeedingChoices(Tabs.ActiveTab);
            string companionLabel = pendingSidekicks == 0 ? "Companions"
                : $"Companions — {pendingSidekicks} {(pendingSidekicks == 1 ? "sidekick has" : "sidekicks have")} unfinished choices";
            <div class="companion-nav-entry">
                <MudNavLink Href="/companions" Icon="@Icons.Material.Filled.Groups"
                            aria-label="@companionLabel" title="@companionLabel">
                    Companions
                </MudNavLink>
                @if (pendingSidekicks > 0)
                {
                    <button type="button" class="nav-choice-badge" @onclick="OpenPendingChoicesAsync" disabled="@_openingChoices"
                            aria-label="Open the first sidekick with unfinished choices" title="Open unfinished sidekick choices">
                        @(pendingSidekicks > 99 ? "99+" : pendingSidekicks.ToString())
                    </button>
                }
            </div>
        }
        <MudTooltip Text="@(_loading ? "Loading character…" : "")" Placement="Placement.Right" Delay="300" Style="display:block">
            <MudNavLink Href="/magic" Icon="@Icons.Material.Filled.AutoAwesome" Disabled="_loading">
                Magic
            </MudNavLink>
        </MudTooltip>
        <MudTooltip Text="@(_loading ? "Loading character…" : "")" Placement="Placement.Right" Delay="300" Style="display:block">
            <MudNavLink Href="/manage" Icon="@Icons.Material.Filled.ManageAccounts" Disabled="_loading">
                Manage
            </MudNavLink>
        </MudTooltip>
        <MudTooltip Text="@(_loading ? "Loading character…" : "")" Placement="Placement.Right" Delay="300" Style="display:block">
            <MudNavLink Href="/sheet" Icon="@Icons.Material.Filled.Article" Disabled="_loading">
                Sheet
            </MudNavLink>
        </MudTooltip>
    }
</MudNavMenu>

@code {
    private bool _disposed;
    private bool _openingChoices;

    private async Task OpenPendingChoicesAsync()
    {
        if (_openingChoices || Tabs.ActiveTab is not { IsLoading: false, Snapshot: not null } tab) return;
        _openingChoices = true;
        try
        {
            (await SidekickService.SynchronizeOwnerLevelsAsync(tab)).ThrowIfFailed();
            if (_disposed || !ReferenceEquals(tab, Tabs.ActiveTab)) return;
            var pending = SidekickService.Load(tab.File)
                .Select(profile => (Profile: profile, Choice: SidekickChoices.Pending(profile).FirstOrDefault()))
                .FirstOrDefault(entry => entry.Choice != null);
            Nav.NavigateTo("/companions");
            if (pending.Profile == null || pending.Choice == null) return;

            var parameters = new DialogParameters
            {
                [nameof(SidekickEditDialog.Tab)] = tab,
                [nameof(SidekickEditDialog.Profile)] = pending.Profile,
                [nameof(SidekickEditDialog.InitialChoiceKey)] = pending.Choice.Key
            };
            var dialog = await DialogService.ShowAsync<SidekickEditDialog>("Edit Sidekick", parameters);
            if (await dialog.Result is { Canceled: false }) Tabs.NotifyChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add(DebugLogService.Catch(ex, "NavMenu.OpenPendingChoices"), Severity.Error);
        }
        finally { _openingChoices = false; }
    }

    protected override void OnInitialized()
    {
        Tabs.TabsChanged += OnTabsChanged;
        Prefs.DeveloperModeChanged += OnDeveloperModeChanged;
    }

    private void OnTabsChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(() => { if (!_disposed) StateHasChanged(); });
    }

    private void OnDeveloperModeChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(() => { if (!_disposed) StateHasChanged(); });
    }

    public void Dispose()
    {
        _disposed = true;
        Tabs.TabsChanged -= OnTabsChanged;
        Prefs.DeveloperModeChanged -= OnDeveloperModeChanged;
    }
}
