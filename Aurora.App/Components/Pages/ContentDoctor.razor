@page "/content-doctor"
@implements IDisposable
@using Aurora.App.Services
@using Aurora.Content
@inject ContentDoctorService Doctor
@inject ContentDatabaseService ContentDb
@inject ISnackbar Snackbar

<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
    <MudText Typo="Typo.h5">Content Doctor</MudText>
    <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Refresh"
               OnClick="Reload" Disabled="@(_loading || _busy || _databaseRefreshing)">Re-check</MudButton>
</div>

@if (_databaseRefreshing)
{
    <MudAlert Severity="Severity.Info">Content is being refreshed. Import diagnostics will update when it finishes.</MudAlert>
}
else if (_problem is not null)
{
    <MudAlert Severity="Severity.Warning">@_problem</MudAlert>
    <MudLink Href="/settings?tab=content">Open content settings</MudLink>
}
else
{
<MudText Typo="Typo.h6" Class="mb-1">Override files</MudText>
<MudText Typo="Typo.body2" Class="mb-4">
    Override files keep a local copy of a content file so a correction can be applied to it. When the
    people who publish that content adopt the same fix, the correction stops doing anything &mdash;
    clearing it here is what eventually lets the override file retire itself.
</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_files.Count == 0)
{
    <MudAlert Severity="Severity.Normal">
        The last import recorded no managed override files.
    </MudAlert>
}
else
{
    @foreach (OverrideFileModel file in _files)
    {
        <MudPaper Class="pa-4 mb-3" Elevation="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <div>
                    <MudText Typo="Typo.subtitle1">@file.DisplayName</MudText>
                    @if (!string.IsNullOrEmpty(file.SourcePath))
                    {
                        <MudText Typo="Typo.caption">corrects @file.SourcePath</MudText>
                    }
                </div>
                <MudChip T="string" Size="Size.Small" Color="@StatusColour(file)">@file.Status</MudChip>
            </MudStack>

            @if (file.Problem is not null)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">@file.Problem</MudAlert>
            }
            else if (file.CanRetire)
            {
                <MudAlert Severity="Severity.Success" Dense="true" Class="mt-3">
                    Every correction here has been accepted and the content matches upstream. The next
                    content refresh will retire this file.
                </MudAlert>
            }

            @if (file.Corrections.Count > 0)
            {
                <MudSimpleTable Dense="true" Hover="true" Class="mt-3">
                    <thead>
                        <tr>
                            <th>Correction</th>
                            <th>Operation</th>
                            <th>Element</th>
                            <th>State</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (OverrideCorrectionModel correction in file.Corrections)
                        {
                            <tr>
                                <td>@correction.Key</td>
                                <td>@correction.Operation</td>
                                <td>
                                    <MudText Typo="Typo.caption">@correction.TargetId</MudText>
                                    @if (!string.IsNullOrWhiteSpace(correction.ReplacementId))
                                    {
                                        <MudText Typo="Typo.caption">&rarr; @correction.ReplacementId</MudText>
                                    }
                                </td>
                                <td>
                                    <MudChip T="string" Size="Size.Small" Color="@CorrectionColour(correction)">
                                        @correction.Summary
                                    </MudChip>
                                </td>
                                <td style="text-align: right;">
                                    @if (correction.Incorporated && !correction.Accepted)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                                   Disabled="_busy"
                                                   OnClick="@(() => Accept(file, correction))">Accept upstream</MudButton>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </MudPaper>
    }
}

<MudText Typo="Typo.h6" Class="mt-8 mb-1">Duplicate element IDs</MudText>
<MudText Typo="Typo.body2" Class="mb-4">
    Element IDs declared by more than one file in the last import. The importer records which
    definition it selected using the content load order and correction rules. Duplicate IDs can
    be intentional overrides; review the selected definition and its alternatives here.
</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_conflicts.Count == 0)
{
    <MudAlert Severity="Severity.Success">
        The last import recorded no duplicate element IDs.
    </MudAlert>
}
else
{
    <MudText Typo="Typo.body2" Class="mb-2">
        @_conflicts.Count element@(_conflicts.Count == 1 ? "" : "s") declared more than once.
    </MudText>
    @foreach (ContentConflictModel conflict in _conflicts)
    {
        <MudPaper Class="pa-4 mb-3" Elevation="1">
            <MudText Typo="Typo.subtitle1">@conflict.Name</MudText>
            <MudText Typo="Typo.caption">@conflict.TypeName &middot; @conflict.AuroraId</MudText>
            <MudSimpleTable Dense="true" Class="mt-3">
                <tbody>
                    @foreach (ConflictDeclarationModel declaration in conflict.Declarations)
                    {
                        <tr>
                            <td style="width: 1%; white-space: nowrap;">
                                <MudChip T="string" Size="Size.Small"
                                         Color="@(declaration.IsWinner ? Color.Success : Color.Default)">
                                    @(declaration.IsWinner ? "In use" : "Set aside")
                                </MudChip>
                            </td>
                            <td>
                                <MudText Typo="Typo.body2">@declaration.PackageName</MudText>
                                <MudText Typo="Typo.caption">@declaration.RelativePath</MudText>
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    }
}

<MudText Typo="Typo.h6" Class="mt-8 mb-1">Import issues and notices</MudText>
<MudText Typo="Typo.body2" Class="mb-4">
    Files, operations, and metadata notices recorded by the last refresh. These stay listed until
    the problem is fixed and the database is refreshed again.
</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    @if (_superseded > 0)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
            @_superseded archived definition@(_superseded == 1 ? "" : "s") replaced by AuroraLegacy.
            The import record keeps their provenance.
        </MudAlert>
    }
    @if (_skipped.Count == 0)
    {
        <MudAlert Severity="Severity.Success">The last import recorded no other content issues.</MudAlert>
    }
    else
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
            @_skipped.Count content issue@(_skipped.Count == 1 ? "" : "s")
            need@(_skipped.Count == 1 ? "s" : "") attention.
        </MudAlert>
        @foreach (ContentImportSkip skip in _skipped.Take(_showAll ? _skipped.Count : 30))
        {
            <MudPaper Class="pa-3 mb-2" Elevation="0" Outlined="true">
                <MudText Typo="Typo.body2"><strong>@skip.RelativePath</strong> &mdash; @Reason(skip.Kind)</MudText>
                <MudText Typo="Typo.caption" Style="font-family: monospace; word-break: break-word;">@skip.Detail</MudText>
                @if (!string.IsNullOrWhiteSpace(skip.RelatedPath))
                {
                    <MudText Typo="Typo.caption">Related definition: @skip.RelatedPath</MudText>
                }
            </MudPaper>
        }
        @if (_skipped.Count > 30)
        {
            <MudButton OnClick="@(() => _showAll = !_showAll)">
                @(_showAll ? "Show fewer" : $"Show all {_skipped.Count}")
            </MudButton>
        }
    }
}
}

@code {
    private IReadOnlyList<OverrideFileModel> _files = [];
    private IReadOnlyList<ContentConflictModel> _conflicts = [];
    private IReadOnlyList<ContentImportSkip> _skipped = [];
    private int _superseded;
    private bool _showAll;
    private bool _loading = true;
    private bool _busy;
    private string? _problem;
    private bool _disposed;
    private bool _databaseRefreshing;
    private CancellationTokenSource? _loadCancellation;

    protected override async Task OnInitializedAsync()
    {
        ContentDb.StateChanged += OnDatabaseStateChanged;
        _databaseRefreshing = ContentDb.SyncState == ContentDatabaseSyncState.Syncing;
        if (!_databaseRefreshing) await Reload();
    }

    private void OnDatabaseStateChanged()
    {
        if (_disposed) return;
        bool syncing = ContentDb.SyncState == ContentDatabaseSyncState.Syncing;
        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;
            if (syncing)
            {
                if (_databaseRefreshing) return;
                _databaseRefreshing = true;
                _loadCancellation?.Cancel();
            }
            else
            {
                _databaseRefreshing = false;
                await Reload();
            }
            if (!_disposed) StateHasChanged();
        });
    }

    private async Task Reload()
    {
        if (_disposed || _databaseRefreshing) return;
        _loadCancellation?.Cancel();
        using var cancellation = new CancellationTokenSource();
        _loadCancellation = cancellation;
        _loading = true;
        _problem = null;
        _showAll = false;
        StateHasChanged();
        try
        {
            var loaded = await Task.Run(() => Doctor.Load(cancellation.Token), cancellation.Token);
            if (_disposed || cancellation.IsCancellationRequested) return;
            _problem = loaded.Problem;
            _files = loaded.Files;
            _conflicts = loaded.Conflicts;
            // Successor selection is expected; preserve its provenance separately.
            _superseded = loaded.Skipped.Count(s => s.Kind == "superseded-definition");
            _skipped = loaded.Skipped.Where(s => s.Kind != "superseded-definition").ToList();
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception ex)
        {
            if (_disposed || cancellation.IsCancellationRequested) return;
            DebugLogService.Catch(ex, "ContentDoctor.Reload");
            _problem = $"Content diagnostics could not be loaded. {ex.Message}";
        }
        finally
        {
            if (ReferenceEquals(_loadCancellation, cancellation))
            {
                _loadCancellation = null;
                _loading = false;
            }
        }
    }

    private async Task Accept(OverrideFileModel file, OverrideCorrectionModel correction)
    {
        if (_disposed || _busy || _loading || _databaseRefreshing) return;
        _busy = true;
        try
        {
            await Task.Run(() => Doctor.AcceptCorrection(file, correction));
            if (_disposed) return;
            Snackbar.Add($"Cleared {correction.Key}. Refresh content to rebuild the database.", Severity.Success);
            await Reload();
        }
        catch (Exception ex) when (ex is IOException or InvalidDataException or UnauthorizedAccessException or System.Xml.XmlException)
        {
            // The hashes captured when the list was read no longer match, or the file cannot be
            // written. Re-read so the reader is deciding from what is actually on disk.
            if (_disposed) return;
            Snackbar.Add(ex.Message, Severity.Error);
            await Reload();
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose()
    {
        _disposed = true;
        ContentDb.StateChanged -= OnDatabaseStateChanged;
        _loadCancellation?.Cancel();
    }

    private static Color StatusColour(OverrideFileModel file) =>
        file.Problem is not null ? Color.Warning
        : file.CanRetire ? Color.Success
        : file.IncorporatedCount > 0 ? Color.Primary
        : Color.Default;

    private static Color CorrectionColour(OverrideCorrectionModel correction) =>
        correction.Accepted ? Color.Success
        : correction.Incorporated ? Color.Primary
        : Color.Default;

    private static string Reason(string kind) => kind switch
    {
        "unreadable" => "the file could not be read; previously imported definitions were kept where available.",
        "definition-collision" => "more than one file defines this element; the import decision and alternatives are kept for review.",
        "superseded-definition" => "AuroraLegacy supplied the successor definition.",
        "classification" => "it was imported without inferring a publisher; review its Source metadata.",
        "conflict" => "it defines an element another file defines differently; review the import decision and related definition.",
        "definition-conflict" => "this element ID is unavailable because its definitions conflict and none was selected. The rest of the file was imported.",
        "correction" => "an earlier refresh left this correction file out; correction errors now stop a refresh to protect working content.",
        "append" => "one of its append operations could not be applied; the rest of the file was imported.",
        "alias" => "a forwarding address it declared was refused; the rest of the file was imported.",
        _ => "it was left out of the last refresh.",
    };
}
