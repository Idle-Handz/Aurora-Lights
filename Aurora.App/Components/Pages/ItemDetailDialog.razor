<MudDialog Style="max-height: 90vh; width: min(720px, 95vw);">
    <TitleContent>
        <MudText Typo="Typo.h6">@Detail.Name</MudText>
    </TitleContent>
    <DialogContent>
        <EquipmentItemDetailContent Detail="@Detail" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Variant="Variant.Text">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public EquipmentItemDetailModel Detail { get; set; } = default!;

    private void Close() => MudDialog.Close();
}
