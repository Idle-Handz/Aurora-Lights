    private async Task ResetCharactersDirAsync()
    {
        _dirError = Characters.ApplyCustomCharactersDirectory(null);
        if (_dirError == null)
        {
            await HandleContentRootChangedAsync();
            if (_dirError == null) Snackbar.Add("Characters folder reset to default.", Severity.Success,
                cfg => cfg.VisibleStateDuration = 3000);
        }
        StateHasChanged();
    }

    private async Task HandleContentRootChangedAsync()
    {
        _dirBusy = true;
        ContentDb.NotifyContentDirectoryChanged();
        _stalenessChecked = false;
        _dbParity = null;
        _needsContentReload = true;
        StateHasChanged();
        try
        {
            _dirError = await Content.ReloadContentAsync();
            if (_disposed) return;
            _needsContentReload = _dirError != null;
            await RefreshDatabaseDiagnosticsAsync();
        }
        finally
        {
            _dirBusy = false;
            if (!_disposed) StateHasChanged();
        }
    }

    public void Dispose()
    {
        _disposed = true;
        ++_diagnosticsRequest;
        _parityCancellation?.Cancel();
        ContentDb.StateChanged -= OnStateChanged;
        Content.Changed -= OnContentChanged;
        AppUpdates.Changed -= OnAppUpdatesChanged;
        Prefs.DeveloperModeChanged -= OnDeveloperModeChanged;
    }
}
