    {
        Snackbar.Add($"That source {what} could not be found.", Severity.Warning,
            cfg => cfg.VisibleStateDuration = 2500);
        return Task.CompletedTask;
    }

    private Task NotifyRequiredSource()
    {
        Snackbar.Add("That source is required and can't be disabled.", Severity.Info,
