    // ── Default source restrictions ──────────────────────────────────────
    // Edited against their own SourcesManager so toggling defaults never disturbs the
    // restrictions of the character currently loaded in the engine singleton.
    private SourcesManager? _defaultSources;
    private bool _defaultSourcesBusy;

    private SourcesManager DefaultSources
    {
        get
        {
            if (_defaultSources is null)
            {
                _defaultSources = new SourcesManager();
                _defaultSources.LoadDefaults();
            }
            return _defaultSources;
        }
    }

    private IReadOnlyList<SourceRestrictionGroupModel> DefaultSourceGroups =>
        DataManager.Current.ElementsCollection.Count == 0
            ? []
            : SourceRestrictionModelMapper.ToGroupModels(DefaultSources);

    private Task ToggleDefaultSourceAsync(string sourceId)
    {
        SourceItem? item = DefaultSources.SourceGroups
            .SelectMany(group => group.Sources)
            .FirstOrDefault(candidate => string.Equals(candidate.Source.Id, sourceId, StringComparison.Ordinal));
        if (item is null) return NotifyMissingSource("source");
        if (!item.AllowUnchecking) return NotifyRequiredSource();
        item.SetIsChecked(item.IsChecked != true, updateChildren: true, updateParent: true);
        return StoreDefaultRestrictions();
    }

    /// <summary>A category or publisher row: every source under it moves together, in one save.</summary>
    private Task ToggleDefaultNodeAsync(SourceRestrictionNodeToggle toggle)
    {
        List<SourceItem> matching = DefaultSources.SourceGroups
            .SelectMany(group => group.Sources)
            .Where(item => item.AllowUnchecking && toggle.SourceIds.Contains(item.Source.Id, StringComparer.Ordinal))
            .ToList();
        if (matching.Count == 0)
        {
            Snackbar.Add("No optional sources are available under that heading.", Severity.Info,
                cfg => cfg.VisibleStateDuration = 2500);
            return Task.CompletedTask;
        }
        foreach (SourceItem item in matching)
            item.SetIsChecked(toggle.IsEnabled, updateChildren: true, updateParent: true);
        return StoreDefaultRestrictions();
    }

    private Task StoreDefaultRestrictions()
    {
        _defaultSourcesBusy = true;
        try
        {
            DefaultSources.ApplyRestrictions();
            DefaultSources.StoreDefaults();
            ApplicationContext.Current.Settings.Save();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not save the default source restrictions: {ex.Message}", Severity.Error,
                cfg => cfg.VisibleStateDuration = 8000);
            DebugLogService.Catch(ex, "Settings.StoreDefaultRestrictions");
        }
        finally
        {
            _defaultSourcesBusy = false;
        }
        StateHasChanged();
        return Task.CompletedTask;
    }

