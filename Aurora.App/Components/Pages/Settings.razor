@page "/settings"
@implements IDisposable
@using Aurora.Content
@using Aurora.Content.Preparation
@using Builder.Presentation
@using Builder.Presentation.Models.Sources
@using Builder.Presentation.Services.Sources
@using Builder.Presentation.Services.Data
@using Aurora.Components.Models
@using System.Text
@inject ContentDatabaseService ContentDb
@inject ContentService Content
@inject CharacterService Characters
@inject ContentDatabaseParityService Parity
@inject CharacterTabService Tabs
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject UserPreferencesService Prefs
@inject DebugLogService DebugLog
@inject AppPageStateService PageState
@inject Aurora.App.Services.AppIdentityService Brand
@inject Aurora.App.Services.Updates.AppUpdateService AppUpdates

<MudText Typo="Typo.h5" Class="mb-4">Settings</MudText>

<MudTabs Elevation="0"
         Rounded="false"
         ApplyEffectsToContainer="true"
         PanelClass="pt-4"
         @bind-ActivePanelIndex="ActiveSettingsTabIndex">

    <!-- ── General ─────────────────────────────────────────────────────────── -->
    <MudTabPanel Text="General">

        <div class="pref-section">
            <div class="section-label">Appearance</div>

            <div class="pref-row theme-pref-row">
                <div class="pref-row-text">
                    <div class="pref-row-title">Theme</div>
                    <div class="pref-row-desc">
                        Choose a complete visual palette for the app. The selection applies immediately
                        and is remembered across launches.
                    </div>
                    <div class="theme-selected-preview" aria-live="polite">
                        <span class="theme-preview-swatch theme-preview-@SelectedTheme.Id" aria-hidden="true">
                            <span></span><span></span><span></span><span></span>
                        </span>
                        <span class="theme-selected-copy">
                            <strong>@SelectedTheme.DisplayName</strong>
                            <span>@SelectedTheme.Description</span>
                        </span>
                    </div>
                </div>
                <MudSelect T="AppTheme"
                           Label="Theme"
                           Value="Prefs.Theme"
                           ValueChanged="@((AppTheme theme) => Prefs.Theme = theme)"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="theme-select"
                           aria-label="Application theme">
                    @foreach (var theme in AppThemes.All)
                    {
                        <MudSelectItem T="AppTheme" Value="theme.Theme">@theme.DisplayName</MudSelectItem>
                    }
                </MudSelect>
            </div>
        </div>

        <div class="pref-section" style="margin-top: 24px;">
            <div class="section-label">Build &amp; Magic</div>

            <div class="pref-row">
                <div class="pref-row-text">
                    <div class="pref-row-title">Auto-save on selection change</div>
                    <div class="pref-row-desc">
                        When enabled, choosing a new option on the Build or Magic page immediately
                        writes the character file to disk. Disable this if you want to experiment
                        with different build choices and save only when satisfied.
                    </div>
                </div>
                <MudSwitch Value="Prefs.AutoSaveBuildChanges"
                           ValueChanged="@((bool v) => Prefs.AutoSaveBuildChanges = v)"
                           Color="Color.Primary" />
            </div>

            <div class="pref-row" style="margin-top: 16px;">
                <div class="pref-row-text">
                    <div class="pref-row-title">Default HP method for new characters</div>
                    <div class="pref-row-desc">
                        Average uses the fixed value for each die size (for example, d8 → 5 per level, max at level 1).
                        Rolled generates random dice values upfront and persists them. Either can be changed
                        per-character on the Build page after creation.
                    </div>
                </div>
                <MudRadioGroup Value="Prefs.DefaultHpMethod"
                               ValueChanged="@((HpMethod v) => Prefs.DefaultHpMethod = v)">
                    <MudRadio Value="HpMethod.Average" Color="Color.Primary">Average</MudRadio>
                    <MudRadio Value="HpMethod.Rolled"  Color="Color.Primary">Rolled</MudRadio>
                </MudRadioGroup>
            </div>

            <div class="pref-row" style="margin-top: 16px;">
                <div class="pref-row-text">
                    <div class="pref-row-title">Allow feats</div>
                    <div class="pref-row-desc">
                        When enabled, new characters can forgo an Ability Score Improvement to take a feat
                        instead. Per-character control is available on the Manage page.
                    </div>
                </div>
                <MudSwitch Value="Prefs.DefaultFeats"
                           ValueChanged="@((bool v) => Prefs.DefaultFeats = v)"
                           Color="Color.Primary" />
            </div>

            <div class="pref-row" style="margin-top: 16px;">
                <div class="pref-row-text">
                    <div class="pref-row-title">Allow multiclassing</div>
                    <div class="pref-row-desc">
                        When enabled, new characters can gain levels in more than one class.
                        Per-character control is available on the Manage page.
                    </div>
                </div>
                <MudSwitch Value="Prefs.DefaultMulticlassing"
                           ValueChanged="@((bool v) => Prefs.DefaultMulticlassing = v)"
                           Color="Color.Primary" />
            </div>

            <div class="pref-row" style="margin-top: 16px;">
                <div class="pref-row-text">
                    <div class="pref-row-title">Customized ability score increases</div>
                    <div class="pref-row-desc">
                        When enabled, new characters default to allowing racial ability score increases to be
                        moved to any ability scores of your choice — keeping the same split (+2 to one, +1 to another).
                        Per-character control is available on the Manage page.
                    </div>
                </div>
                <MudSwitch Value="Prefs.DefaultCustomOrigin"
                           ValueChanged="@((bool v) => Prefs.DefaultCustomOrigin = v)"
                           Color="Color.Primary" />
            </div>

            <div class="pref-row" style="margin-top: 16px;">
                <div class="pref-row-text">
                    <div class="pref-row-title">Customized language</div>
                    <div class="pref-row-desc">
                        When enabled, new characters default to allowing the fixed racial language to be
                        swapped for any other standard language of your choice.
                        Per-character control is available on the Manage page.
                    </div>
                </div>
                <MudSwitch Value="Prefs.DefaultCustomLanguage"
                           ValueChanged="@((bool v) => Prefs.DefaultCustomLanguage = v)"
                           Color="Color.Primary" />
            </div>

            <div class="pref-row" style="margin-top: 16px;">
                <div class="pref-row-text">
                    <div class="pref-row-title">Customized proficiencies</div>
                    <div class="pref-row-desc">
                        When enabled, new characters default to allowing fixed racial skill proficiencies to be
                        swapped for any other skill proficiency of your choice.
                        Per-character control is available on the Manage page.
                    </div>
                </div>
                <MudSwitch Value="Prefs.DefaultCustomProficiency"
                           ValueChanged="@((bool v) => Prefs.DefaultCustomProficiency = v)"
                           Color="Color.Primary" />
            </div>
        </div>

        <div class="pref-section" style="margin-top: 24px;">
            <div class="section-label">Character Storage</div>

            <div style="margin-bottom: 12px;">
                <div class="pref-row-desc">
                    Character files (.dnd5e) are saved to and loaded from this directory.
                    @if (OperatingSystem.IsAndroid())
                    {
                        <span> On Android, switching to <b>External Storage</b> makes files accessible from any file manager app without needing ADB or root.</span>
                    }
                </div>
            </div>

            <div style="margin-bottom: 12px;">
                <div class="pref-row-title" style="margin-bottom: 4px;">Current location</div>
                <div style="font-family: monospace; font-size: 12px; color: var(--mud-palette-text-secondary); word-break: break-all;">
                    @Characters.CharactersDirectory
                </div>
            </div>

            @if (Tabs.Tabs.Count > 0)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                    Close all character tabs before changing the storage location.
                </MudAlert>
            }

            <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                @if (OperatingSystem.IsAndroid())
                {
                    string? extPath = CharacterService.GetAndroidExternalStoragePath();
                    bool alreadyExternal = extPath != null &&
                        Characters.CharactersDirectory.StartsWith(extPath, StringComparison.Ordinal);
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Disabled="@(Tabs.Tabs.Count > 0 || alreadyExternal || _dirBusy)"
                               OnClick="UseExternalStorageAsync">
                        Use External Storage
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Disabled="@(Tabs.Tabs.Count > 0 || _dirBusy)"
                               StartIcon="@Icons.Material.Filled.FolderOpen"
                               OnClick="BrowseCharactersDirAsync">
                        Browse…
                    </MudButton>
                }

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           Size="Size.Small"
                           Disabled="@(Tabs.Tabs.Count > 0 || _dirBusy || string.IsNullOrEmpty(ApplicationContext.Current.Settings.DocumentsRootDirectory))"
                           OnClick="ResetCharactersDirAsync">
                    Reset to Default
                </MudButton>
            </div>

            @if (_dirError != null)
            {
                <MudAlert Severity="Severity.Error" Class="mt-3" Dense="true"
                          ShowCloseIcon="true" CloseIconClicked="() => _dirError = null">
                    @_dirError
                </MudAlert>
            }
        </div>

    </MudTabPanel>

    <!-- ── Character Sheet ──────────────────────────────────────────────────── -->
    <MudTabPanel Text="Character Sheet">

        <div class="pref-section">
            <div class="section-label">PDF Cards</div>
            <div class="pref-row-desc" style="margin-bottom: 16px;">
                Choose which extra card pages to append when generating a character sheet PDF.
            </div>

            <div class="pref-row">
                <div class="pref-row-text">
                    <div class="pref-row-title">Include spell cards</div>
                    <div class="pref-row-desc">
                        Adds a page of spell cards at the end of the PDF. Each spell the character knows
                        or has prepared gets its own card with casting details and description.
                    </div>
                </div>
                <MudSwitch Value="Prefs.IncludeSpellCards"
                           ValueChanged="@((bool v) => Prefs.IncludeSpellCards = v)"
                           Color="Color.Primary" />
            </div>

            <div class="pref-row" style="margin-top: 16px;">
                <div class="pref-row-text">
                    <div class="pref-row-title">Include item cards</div>
                    <div class="pref-row-desc">
                        Adds a page of item cards for equipment marked to show as a card. Each item
                        gets its own card with its category, description, and source.
                    </div>
                </div>
                <MudSwitch Value="Prefs.IncludeItemCards"
                           ValueChanged="@((bool v) => Prefs.IncludeItemCards = v)"
                           Color="Color.Primary" />
            </div>

            <div class="pref-row" style="margin-top: 16px;">
                <div class="pref-row-text">
                    <div class="pref-row-title">Include attack cards</div>
                    <div class="pref-row-desc">
                        Adds a page of attack cards for weapons and abilities configured to appear as cards,
                        showing attack bonus, damage, range, and description.
                    </div>
                </div>
                <MudSwitch Value="Prefs.IncludeAttackCards"
                           ValueChanged="@((bool v) => Prefs.IncludeAttackCards = v)"
                           Color="Color.Primary" />
            </div>

            <div class="pref-row" style="margin-top: 16px;">
                <div class="pref-row-text">
                    <div class="pref-row-title">Include feature cards</div>
                    <div class="pref-row-desc">
                        Adds a page of feature cards for class features, racial traits, feats, and other
                        abilities that are enabled to display on the character sheet.
                    </div>
                </div>
                <MudSwitch Value="Prefs.IncludeFeatureCards"
                           ValueChanged="@((bool v) => Prefs.IncludeFeatureCards = v)"
                           Color="Color.Primary" />
            </div>
        </div>

    </MudTabPanel>

    <!-- ── Content ──────────────────────────────────────────────────────────── -->
    <MudTabPanel Text="Content">

        <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true" PanelClass="pt-3" @bind-ActivePanelIndex="ActiveContentTabIndex">

            <!-- ── Sources sub-tab ────────────────────────────────────────────── -->
            <MudTabPanel Text="Sources">

                <div class="pref-section" style="margin-bottom: 24px;">
                    <div class="section-label">Default source restrictions</div>
                    <div class="pref-row-desc" style="margin-bottom: 10px;">
                        All installed content is always loaded. These defaults decide which sources a
                        character may use whenever it has not chosen its own: new characters start from
                        them, and so does any older file that never recorded restrictions. A character
                        that has its own keeps them &mdash; edit those on its Manage tab, where Load
                        Default brings it back to what you set here. Builder infrastructure stays enabled.
                    </div>

                    @if (DefaultSourceGroups.Count == 0)
                    {
                        <div style="font-size: 13px; color: var(--mud-palette-text-disabled);">
                            No sources found. Refresh the database to index installed content.
                        </div>
                    }
                    else
                    {
                        <SourceRestrictionsEditor Groups="DefaultSourceGroups"
                                                  Busy="_defaultSourcesBusy"
                                                  OnToggleNode="ToggleDefaultNodeAsync"
                                                  OnToggleItem="ToggleDefaultSourceAsync" />
                    }
                </div>

                <div class="pref-section">

                    <div style="margin-bottom: 16px;">
                        <div class="pref-row-title" style="margin-bottom: 4px;">Built-in custom directory</div>
                        <div style="font-family: monospace; font-size: 12px; color: var(--mud-palette-text-secondary); word-break: break-all;">
                            @Content.BuiltInCustomDirectory
                        </div>
                        <div class="pref-row-desc" style="margin-top: 4px;">
                            Place XML files or .index files here and refresh the database to pick them up.
                        </div>
                    </div>

                    <div style="margin-bottom: 6px;">
                        <div class="pref-row-title">Additional content directories</div>
                        <div class="pref-row-desc" style="margin-bottom: 10px;">
                            Extra folders containing Aurora XML content, useful for homebrew or
                            third-party content stored outside the built-in custom directory.
                        </div>

                        @if (Content.AdditionalDirectories.Count == 0)
                        {
                            <div style="font-size: 13px; color: var(--mud-palette-text-disabled); margin-bottom: 8px;">No additional directories configured.</div>
                        }
                        else
                        {
                            <div style="display: flex; flex-direction: column; gap: 6px; margin-bottom: 10px;">
                                @foreach (var dir in Content.AdditionalDirectories.ToList())
                                {
                                    var d = dir;
                                    <div style="display: flex; align-items: center; gap: 8px; background: var(--mud-palette-background-grey); border-radius: 6px; padding: 6px 10px;">
                                        <span style="font-family: monospace; font-size: 12px; color: var(--mud-palette-text-primary); flex: 1; word-break: break-all;">@d</span>
                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                       Size="Size.Small"
                                                       title="Remove"
                                                       OnClick="() => RemoveDirectory(d)"
                                                       Style="padding: 2px; flex-shrink: 0;" />
                                    </div>
                                }
                            </div>
                        }

                        <div class="settings-action-row" style="margin-top: 4px;">
                            <MudTextField @bind-Value="_newDirPath"
                                          Label="Folder path"
                                          Placeholder="C:\path\to\homebrew\content"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Style="flex: 1; font-size: 13px;"
                                          Immediate="true"
                                          @onkeydown="OnDirKeyDown" />
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Disabled="@string.IsNullOrWhiteSpace(_newDirPath)"
                                       OnClick="AddDirectory"
                                       Class="settings-action-button">
                                Add
                            </MudButton>
                        </div>
                    </div>

                    <div style="margin-top: 24px;">
                        <div class="pref-row-title">Content index files (.index)</div>
                        <div class="pref-row-desc" style="margin-bottom: 10px;">
                            Paste a URL ending in <code>.index</code> to register it, then check for updates
                            to download the content. Requires a network connection.
                        </div>

                        <MudSwitch T="bool"
                                   Value="Prefs.AutoDownloadContentOnStartup"
                                   ValueChanged="@(v => Prefs.AutoDownloadContentOnStartup = v)"
                                   Color="Color.Primary"
                                   Label="Auto-download content on startup" />
                        <div class="pref-row-desc" style="margin-bottom: 10px;">
                            Quietly checks installed index sources when the app launches and downloads
                            changed XML files. A refresh prompt appears when new content arrives.
                        </div>

                        @{
                            int installedIndexCount = Content.InstalledIndexNames.Count;
                        }
                        <div class="settings-action-row" style="margin-bottom: 10px;">
                            @* Immediate="true" fires the binding on every keypress/paste — without
                               it the field only commits on blur or Enter, so a freshly-pasted URL
                               leaves Fetch Index stuck disabled until the user nudges focus. *@
                            <MudTextField @bind-Value="_indexUrl"
                                          Label="Index URL"
                                          Placeholder="https://raw.githubusercontent.com/.../core.index"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          Style="flex: 1; font-size: 13px;"
                                          Disabled="_contentWorking" />
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Disabled="@(_contentWorking || string.IsNullOrWhiteSpace(_indexUrl))"
                                       OnClick="FetchIndexAsync"
                                       Class="settings-action-button">
                                Fetch Index
                            </MudButton>
                        </div>

                        <div class="settings-inline-actions">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       StartIcon="@(IsCheckingInstalledSources ? null : Icons.Material.Filled.Sync)"
                                       Size="Size.Small"
                                       Disabled="@(_contentWorking || IsCheckingInstalledSources || installedIndexCount == 0)"
                                       OnClick="CheckForUpdatesAsync"
                                       Style="min-width: 160px;">
                                @InstalledSourceButtonText
                            </MudButton>
                            @if (IsCheckingInstalledSources)
                            {
                                <MudProgressCircular Indeterminate="true"
                                                     Size="Size.Small"
                                                     Color="Color.Default"
                                                     Style="width: 18px; height: 18px;" />
                            }
                        </div>
                        @if (Content.IsCheckingContentUpdates)
                        {
                            <div style="margin-top: 8px;">
                                @if (Content.ContentUpdateProgress is int progress)
                                {
                                    <MudProgressLinear Value="@progress"
                                                       Min="0"
                                                       Max="100"
                                                       Color="Color.Primary"
                                                       Class="mt-1" />
                                }
                                else
                                {
                                    <MudProgressLinear Indeterminate="true"
                                                       Color="Color.Primary"
                                                       Class="mt-1" />
                                }
                                <div class="pref-row-desc" style="margin-top: 4px;">
                                    @InstalledSourceStatusText
                                </div>
                            </div>
                        }
                    </div>

                    @if (_needsContentReload)
                    {
                        <MudAlert Severity="Severity.Info" Class="mt-4" Dense="true">
                            Content changes will not take effect until the database is refreshed.
                            @if (Content.HasOpenTabs)
                            {
                                <span> Close open character tabs first.</span>
                            }
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       Disabled="@(_contentWorking || Content.HasOpenTabs)"
                                       OnClick="RefreshDatabaseAsync"
                                       Style="margin-left: 12px;">
                                @(_contentWorking ? "Refreshing..." : "Refresh Database")
                            </MudButton>
                        </MudAlert>
                    }

                    @if (_contentStatus != null)
                    {
                        <MudAlert Severity="@_contentStatusSeverity" Class="mt-3" Dense="true"
                                  ShowCloseIcon="true" CloseIconClicked="() => _contentStatus = null">
                            @_contentStatus
                        </MudAlert>
                    }

                </div>

            </MudTabPanel>

            <!-- ── Data sub-tab ───────────────────────────────────────────────── -->
            <MudTabPanel Text="Data">

                <div class="pref-section">
                    <div class="section-label">Database</div>
                    <div class="pref-row-desc" style="margin-bottom: 16px;">
                        Manage the installed content database and keep it in sync with your content directory.
                        The database file is stored inside that content directory, so changing the
                        character storage root also changes which database is used.
                    </div>

                    <div style="margin-bottom: 12px;">
                        <div class="pref-row-title" style="margin-bottom: 4px;">Content directory</div>
                        <div style="font-family: monospace; font-size: 12px; color: var(--mud-palette-text-secondary); word-break: break-all;">
                            @(string.IsNullOrWhiteSpace(ContentDb.ContentDirectory) ? "(not available)" : ContentDb.ContentDirectory)
                        </div>
                    </div>

                    <div style="margin-bottom: 12px;">
                        <div class="pref-row-title" style="margin-bottom: 4px;">Database path</div>
                        <div style="font-family: monospace; font-size: 12px; color: var(--mud-palette-text-secondary); word-break: break-all;">
                            @(ContentDb.DatabasePath ?? "(not available)")
                        </div>
                    </div>

                    <div style="margin-bottom: 16px; overflow-wrap: anywhere;">
                        <div class="pref-row-title" style="margin-bottom: 4px;">Status</div>
                        @if (ContentDb.SyncState == ContentDatabaseSyncState.Syncing || _checkingStale || _reloadingElements)
                        {
                            <div role="status" aria-live="polite" style="display: flex; align-items: center; gap: 8px; color: var(--mud-palette-primary); font-size: 13px;">
                                @if (!DatabaseProgressIndeterminate)
                                {
                                    @* CSS animation keeps activity visible between library callbacks and long SQL operations. *@
                                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" aria-hidden="true" />
                                }
                                @DatabaseProgressLabel
                            </div>
                            <MudProgressLinear Indeterminate="@DatabaseProgressIndeterminate"
                                               Value="@SyncPercent"
                                               Min="0" Max="100"
                                               Color="Color.Primary"
                                               aria-label="Content database progress"
                                               Class="mt-2" />
                            @if (ContentDb.SyncState == ContentDatabaseSyncState.Syncing && ContentDb.Progress?.CurrentFile is { Length: > 0 } currentFile)
                            {
                                <div class="pref-row-desc" style="overflow-wrap: anywhere; margin-top: 4px;">@currentFile</div>
                            }
                        }
                        else if (!string.IsNullOrWhiteSpace(ContentDb.LastReadFailure))
                        {
                            <div style="color: var(--mud-palette-warning); font-size: 13px;">
                                Database read failed: @ContentDb.LastReadFailure
                            </div>
                        }
                        else if (ContentDb.LastResult != null)
                        {
                            <div style="color: @(ContentDb.LastResult.Success ? "var(--mud-palette-success)" : "var(--mud-palette-error)"); font-size: 13px;">
                                @ContentDb.LastResult.Summary
                            </div>
                        }
                        else if (ContentDb.IsStale)
                        {
                            <div style="color: var(--mud-palette-warning); font-size: 13px;">Database is out of date. Refresh Database to sync and refresh element data.</div>
                        }
                        else if (_stalenessChecked)
                        {
                            <div style="color: var(--mud-palette-success); font-size: 13px;">Database is up to date.</div>
                        }
                        else
                        {
                            <div style="font-size: 13px; color: var(--mud-palette-text-disabled);">Not checked yet.</div>
                        }
                    </div>

                    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   Size="Size.Small"
                                   Disabled="@(ContentDb.SyncState == ContentDatabaseSyncState.Syncing || _checkingStale || _reloadingElements)"
                                   OnClick="CheckStaleAsync">
                            @(_checkingStale ? "Checking…" : "Check for Changes")
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   Disabled="@(_reloadingElements || _checkingStale || ContentDb.SyncState == ContentDatabaseSyncState.Syncing || string.IsNullOrWhiteSpace(ContentDb.ContentDirectory) || Tabs.Tabs.Count > 0)"
                                   OnClick="RefreshDatabaseAsync">
                            @(_reloadingElements ? "Refreshing..." : "Refresh Database")
                        </MudButton>
                    </div>

                    <div class="pref-row-desc" style="margin-top: 10px;">
                        @if (Prefs.DevMode)
                        {
                            <span>Review local corrections and import issues in <MudLink Href="/content-doctor">Content Doctor</MudLink>.</span>
                        }
                        else
                        {
                            <span>Enable Developer / debug mode under Advanced to review local corrections and import issues in Content Doctor.</span>
                        }
                    </div>

                    <div class="pref-row" style="margin-top: 14px;">
                        <div class="pref-row-text">
                            <div class="pref-row-title">Skip content files that can't be imported</div>
                            <div class="pref-row-desc">
                                Import as much usable content as possible and list what was left out in
                                Content Doctor. AuroraLegacy replaces overlapping archived aurorabuilder
                                definitions. Where more than one file defines an element, the declaration
                                Aurora Builder would load last wins and the alternatives are kept for review.
                                Unreadable files and invalid append operations are skipped. Correction errors still
                                stop activation. Turn this off to stop on unreadable files, invalid appends, or new unresolved collisions.
                            </div>
                        </div>
                        <MudSwitch Value="SkipUnusableContent"
                                   ValueChanged="@((bool v) => SetSkipUnusableContent(v))"
                                   Color="Color.Primary" />
                    </div>

                    @if (Tabs.Tabs.Count > 0 && !string.IsNullOrWhiteSpace(ContentDb.ContentDirectory))
                    {
                        <MudAlert Severity="Severity.Info" Class="mt-4" Dense="true">
                            Close all character tabs before refreshing the database so loaded characters do not keep stale element references.
                        </MudAlert>
                    }
                </div>

            </MudTabPanel>

        </MudTabs>

    </MudTabPanel>

    <!-- ── Updates ──────────────────────────────────────────────────────────── -->
    <MudTabPanel Text="Updates">

        @* GitHub release checks cover app builds. Installed .index sources are checked
           separately because they update local XML files. *@
        <div class="pref-section">
            <div class="section-label">App</div>

            <div class="pref-row">
                <div class="pref-row-text">
                    <div class="pref-row-title">Current version</div>
                    <div class="pref-row-desc">@Brand.VersionLabel</div>
                </div>
            </div>

            <div class="pref-row" style="margin-top: 16px;">
                <div class="pref-row-text">
                    <div class="pref-row-title">Check for app updates on startup</div>
                    <div class="pref-row-desc">
                        Quietly checks the project's GitHub Releases when the app starts and surfaces the
                        update badge if a newer app version is published.
                    </div>
                </div>
                <MudSwitch Value="Prefs.StartupCheckForAppUpdates"
                           ValueChanged="@((bool v) => Prefs.StartupCheckForAppUpdates = v)"
                           Color="Color.Primary" />
            </div>

            <div class="pref-row" style="margin-top: 16px;">
                <div class="pref-row-text">
                    <div class="pref-row-title">Include pre-releases</div>
                    <div class="pref-row-desc">
                        Includes alpha/beta/RC builds in the check. Recommended while the app is still
                        in early development — otherwise the check sees nothing.
                    </div>
                </div>
                <MudSwitch Value="Prefs.IncludePrereleasesInUpdateCheck"
                           ValueChanged="@((bool v) => Prefs.IncludePrereleasesInUpdateCheck = v)"
                           Color="Color.Primary" />
            </div>

            <div class="pref-row" style="margin-top: 16px;">
                <div class="pref-row-text">
                    <div class="pref-row-title">App release channel</div>
                    <div class="pref-row-desc">
                        @if (_checkingReleaseChannels || AppUpdates.IsChecking)
                        {
                            <text>Checking GitHub...</text>
                        }
                        else if (AppUpdates.LastError is { Length: > 0 } err)
                        {
                            <text>Last check failed: @err</text>
                        }
                        else if (AppUpdates.Latest is { } a)
                        {
                            <text>
                                Latest: <b>@a.LatestTag</b>
                                @(a.IsPreRelease ? "(pre-release) " : "")
                                — @(a.IsNewer ? "newer than current" : "you're up to date")
                                · checked @(FormatChecked(AppUpdates.LastChecked))
                            </text>
                        }
                        else if (AppUpdates.LastChecked is { } when_)
                        {
                            <text>No eligible release found · checked @(FormatChecked(when_))</text>
                        }
                        else
                        {
                            <text>Never checked.</text>
                        }
                    </div>
                </div>
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="CheckAppReleaseNowAsync"
                           Disabled="@(_checkingReleaseChannels || AppUpdates.IsChecking)">
                    Check app release
                </MudButton>
            </div>

            @if (AppUpdates.Latest is { IsNewer: true } avail)
            {
                @if (!string.IsNullOrWhiteSpace(avail.ReleaseNotes))
                {
                    <MudPaper Outlined="true" Class="pa-4 mt-4" aria-label="@($"Release notes for {avail.LatestTag}")">
                        <MudText Typo="Typo.overline" Color="Color.Primary">
                            Release notes for @avail.LatestTag
                        </MudText>
                        <ReleaseNotesContent Markdown="@avail.ReleaseNotes" />
                    </MudPaper>
                }

#if WINDOWS
                @* On a Velopack install the user gets a one-click "Install and restart" path.
                   On a plain ZIP extract IsVelopackInstall is false, so we fall back to the
                   browser link. Both paths show on Windows; only the browser link on other
                   platforms (macOS pending signing, Android via Play Store). *@
                @if (AppUpdates.IsVelopackInstall)
                {
                    <div class="pref-row" style="margin-top: 16px;">
                        <div class="pref-row-text">
                            <div class="pref-row-title">
                                @(AppUpdates.ApplyOnExitScheduled
                                    ? $"{avail.LatestTag} ready for next launch"
                                    : _applying
                                        ? "Downloading update…"
                                        : $"Install {avail.LatestTag}")
                            </div>
                            <div class="pref-row-desc">
                                @if (_applying)
                                {
                                    <MudProgressLinear Value="@_applyProgress"
                                                       Min="0" Max="100"
                                                       Color="Color.Primary"
                                                       Class="mt-1"
                                                       Style="max-width: 280px;" />
                                }
                                else if (AppUpdates.ApplyOnExitScheduled)
                                {
                                    <text>The update is downloaded. Close the app normally when convenient; your next launch will use @avail.LatestTag.</text>
                                }
                                else if (_applyError is { Length: > 0 } err)
                                {
                                    <text>Update failed: @err</text>
                                }
                                else
                                {
                                    <text>Install immediately and restart, or download now and finish the update when you close the app.</text>
                                }
                            </div>
                        </div>
                        <div class="settings-inline-actions">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.SystemUpdateAlt"
                                       Disabled="_applying"
                                       OnClick="ApplyUpdateAsync">
                                @(_applying ? "Downloading…" : "Install and restart")
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Schedule"
                                       Disabled="@(_applying || AppUpdates.ApplyOnExitScheduled)"
                                       OnClick="PrepareUpdateOnCloseAsync">
                                @(AppUpdates.ApplyOnExitScheduled ? "Ready on close" : "Install on close")
                            </MudButton>
                        </div>
                    </div>
                }
                else
                {
                    <div class="pref-row" style="margin-top: 16px;">
                        <div class="pref-row-text">
                            <div class="pref-row-title">View release</div>
                            <div class="pref-row-desc">
                                Opens the GitHub release page for @avail.LatestTag in your browser.
                                Run the installer from there to upgrade.
                            </div>
                        </div>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.OpenInNew"
                                   Disabled="@string.IsNullOrWhiteSpace(avail.ReleaseUrl)"
                                   OnClick="@(() => OpenReleaseAsync(avail.ReleaseUrl))">
                            Open release
                        </MudButton>
                    </div>
                }
#else
                <div class="pref-row" style="margin-top: 16px;">
                    <div class="pref-row-text">
                        <div class="pref-row-title">View release</div>
                        <div class="pref-row-desc">Opens the GitHub release page for @avail.LatestTag in your browser.</div>
                    </div>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.OpenInNew"
                               Disabled="@string.IsNullOrWhiteSpace(avail.ReleaseUrl)"
                               OnClick="@(() => OpenReleaseAsync(avail.ReleaseUrl))">
                        Open release
                    </MudButton>
                </div>
#endif
            }
        </div>

        <div class="pref-section" style="margin-top: 24px;">
            <div class="section-label">Content</div>

            @{
                int installedIndexCountOnUpdates = Content.InstalledIndexNames.Count;
            }
            <div class="pref-row">
                <div class="pref-row-text">
                    <div class="pref-row-title">Installed content sources</div>
                    <div class="pref-row-desc">
                        @if (IsCheckingInstalledSources)
                        {
                            @InstalledSourceStatusText
                        }
                        else if (installedIndexCountOnUpdates == 0)
                        {
                            <text>No installed .index sources found. Manage source registration in Content.</text>
                        }
                        else if (!string.IsNullOrWhiteSpace(Content.ContentUpdateStatus))
                        {
                            @Content.ContentUpdateStatus
                        }
                        else
                        {
                            <text>@installedIndexCountOnUpdates installed .index source(s). Manage source registration in Content.</text>
                        }
                    </div>
                </div>
                <div class="settings-inline-actions">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@(IsCheckingInstalledSources ? null : Icons.Material.Filled.Sync)"
                               Disabled="@(_contentWorking || IsCheckingInstalledSources || installedIndexCountOnUpdates == 0)"
                               OnClick="CheckForUpdatesAsync">
                        @InstalledSourceButtonText
                    </MudButton>
                    @if (IsCheckingInstalledSources)
                    {
                        <MudProgressCircular Indeterminate="true"
                                             Size="Size.Small"
                                             Color="Color.Default"
                                             Style="width: 18px; height: 18px;" />
                    }
                </div>
            </div>

            @if (Content.IsCheckingContentUpdates)
            {
                <div style="margin-top: 10px;">
                    @if (Content.ContentUpdateProgress is int progress)
                    {
                        <MudProgressLinear Value="@progress"
                                           Min="0"
                                           Max="100"
                                           Color="Color.Primary"
                                           Class="mt-1" />
                    }
                    else
                    {
                        <MudProgressLinear Indeterminate="true"
                                           Color="Color.Primary"
                                           Class="mt-1" />
                    }
                </div>
            }

            @if (_needsContentReload)
            {
                <MudAlert Severity="Severity.Info" Class="mt-4" Dense="true">
                    Content changes will not take effect until the database is refreshed.
                    @if (Content.HasOpenTabs)
                    {
                        <span> Close open character tabs first.</span>
                    }
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Disabled="@(_contentWorking || Content.HasOpenTabs)"
                               OnClick="RefreshDatabaseAsync"
                               Style="margin-left: 12px;">
                        @(_contentWorking ? "Refreshing..." : "Refresh Database")
                    </MudButton>
                </MudAlert>
            }

            @if (_contentStatus != null)
            {
                <MudAlert Severity="@_contentStatusSeverity" Class="mt-3" Dense="true"
                          ShowCloseIcon="true" CloseIconClicked="() => _contentStatus = null">
                    @_contentStatus
                </MudAlert>
            }
        </div>

    </MudTabPanel>

    <!-- ── Advanced ─────────────────────────────────────────────────────────── -->
    <MudTabPanel Text="Advanced">

        <div class="pref-section">
            <div class="section-label">Developer</div>

            <div class="pref-row">
                <div class="pref-row-text">
                    <div class="pref-row-title">Developer / debug mode</div>
                    <div class="pref-row-desc">
                        Shows a Console page in the navigation menu where runtime exceptions and
                        diagnostic messages are captured. Useful for diagnosing crashes.
                    </div>
                </div>
                <MudSwitch Value="Prefs.DevMode"
                           ValueChanged="@((bool v) => Prefs.DevMode = v)"
                           Color="Color.Secondary" />
            </div>

            @if (Prefs.DevMode)
            {
                <div class="pref-row" style="margin-top: 16px;">
                    <div class="pref-row-text">
                        <div class="pref-row-title">Log entries: @DebugLog.Entries.Count</div>
                        <div class="pref-row-desc">Errors: @DebugLog.Entries.Count(e => e.Level == LogLevel.Error)</div>
                    </div>
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                               Href="/console">Open Console</MudButton>
                </div>

                <div class="pref-row" style="margin-top: 16px;">
                    <div class="pref-row-text">
                        <div class="pref-row-title">Element data source: @Characters.ElementLoadSource</div>
                        <div class="pref-row-desc">@Characters.ElementLoadSummary</div>
                        @if (Characters.ElementLoadSchemaVersion.HasValue)
                        {
                            <div class="pref-row-desc">Schema version: @Characters.ElementLoadSchemaVersion.Value</div>
                        }
                        @if (Characters.ElementLoadDataVersion.HasValue)
                        {
                            <div class="pref-row-desc">Data version: @Characters.ElementLoadDataVersion.Value</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Characters.ElementLoadImporterVersion))
                        {
                            <div class="pref-row-desc">Importer version: @Characters.ElementLoadImporterVersion</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Characters.ElementLoadBuiltUtc))
                        {
                            <div class="pref-row-desc">DB built: @FormatUtc(Characters.ElementLoadBuiltUtc)</div>
                        }
                        @if (Characters.ElementLoadSourceFileCount.HasValue)
                        {
                            <div class="pref-row-desc">Indexed files: @Characters.ElementLoadSourceFileCount.Value</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Characters.ElementLoadDatabasePath))
                        {
                            <div class="pref-row-desc" style="font-family: monospace; word-break: break-all;">
                                DB path: @Characters.ElementLoadDatabasePath
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Characters.ElementLoadContentRootHash))
                        {
                            <div class="pref-row-desc" style="font-family: monospace; word-break: break-all;">
                                Content hash: @Characters.ElementLoadContentRootHash
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Characters.ElementLoadFailureReason))
                        {
                            <div class="pref-row-desc">Fallback reason: @Characters.ElementLoadFailureReason</div>
                        }
                        @if (Characters.ElementLoadSkippedElements > 0)
                        {
                            <div class="pref-row-desc">Skipped elements during DB load: @Characters.ElementLoadSkippedElements</div>
                        }
                    </div>
                </div>
            }
        </div>

        @if (Prefs.DevMode)
        {
            <div class="pref-section settings-diagnostics" style="margin-top: 24px;">
                <div class="section-label">Database Diagnostics</div>

                @{
                    var dbMeta = _dbMetadata;
                }
                @if (!string.IsNullOrWhiteSpace(_diagnosticsProblem))
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">@_diagnosticsProblem</MudAlert>
                }
                @if (dbMeta != null)
                {
                    <div style="margin-bottom: 16px;">
                        <div class="pref-row-title" style="margin-bottom: 4px;">Database metadata</div>
                        <div class="pref-row-desc">Schema v@(dbMeta.SchemaVersion), data v@(dbMeta.DataVersion), importer @dbMeta.ImporterVersion</div>
                        <div class="pref-row-desc">Built: @FormatUtc(dbMeta.BuiltUtc)</div>
                        <div class="pref-row-desc">Indexed files: @dbMeta.SourceFileCount, elements: @dbMeta.ElementCount</div>
                    </div>
                }

                @if (_dbHealth != null)
                {
                    <div style="margin-bottom: 16px;">
                        <div class="pref-row-title" style="margin-bottom: 6px;">Content trust</div>
                        <div class="pref-row-desc" style="margin-bottom: 6px;">
                            Problems recorded during the last database refresh, grouped by source file.
                            After correcting a file, refresh the database to update these results.
                        </div>
                        <MudAlert Severity="@HealthSeverity(_dbHealth)"
                                  Dense="true"
                                  Variant="Variant.Outlined"
                                  Class="mb-2">
                            @HealthSummary(_dbHealth)
                        </MudAlert>
                        @foreach (var file in _dbHealth.Samples.Where(sample => NeedsAttention(sample.Impact))
                            .GroupBy(sample => sample.FilePath)
                            .OrderBy(file => file.Min(sample => TrustImpactOrder(sample.Impact)))
                            .ThenBy(file => file.Key, StringComparer.OrdinalIgnoreCase))
                        {
                            <section class="content-problem-file @(file.Any(sample => sample.Impact == ContentDatabaseTrustImpact.Blocking) ? "has-errors" : "needs-review")">
                                <div class="pref-row-title content-problem-path">
                                    @(string.IsNullOrWhiteSpace(file.Key) ? "Source file unavailable" : file.Key)
                                </div>
                                @foreach (var sample in file.OrderBy(sample => TrustImpactOrder(sample.Impact)))
                                {
                                    <div class="content-problem">
                                        <div>
                                            <strong class="@(sample.Impact == ContentDatabaseTrustImpact.Blocking ? "content-error-label" : "content-review-label")">@TrustImpactLabel(sample.Impact):</strong>
                                            @HealthIssueExplanation(sample)
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(sample.Owner))
                                        {
                                            <div class="pref-row-desc">Element: <code>@sample.Owner</code></div>
                                        }
                                        @if (sample.Area == "unresolved-link" && !string.IsNullOrWhiteSpace(sample.Key))
                                        {
                                            <div class="pref-row-desc">Missing target: <code>@sample.Key</code></div>
                                        }
                                        else if (sample.Reason == "duplicate-element-id-in-file")
                                        {
                                            <div class="pref-row-desc">Repeated ID: <code>@sample.Key</code></div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(sample.Text) && sample.Text != sample.Key)
                                        {
                                            <details class="content-problem-detail">
                                                <summary>Rule details</summary>
                                                <code>@sample.Text</code>
                                            </details>
                                        }
                                    </div>
                                }
                            </section>
                        }
                        @if (_dbHealth.AutoRecoveredIssueCount > 0 || _dbHealth.ExpectedIssueCount > 0)
                        {
                            <details class="content-information">
                                <summary>Informational — @_dbHealth.AutoRecoveredIssueCount auto-recovered, @_dbHealth.ExpectedIssueCount expected</summary>
                                <div class="pref-row-desc">These findings do not require corrections. The importer handled the recovered findings and classified the expected links.</div>
                                @foreach (var group in _dbHealth.Groups.Where(group => !NeedsAttention(group.Impact))
                                    .OrderBy(group => TrustImpactOrder(group.Impact)).ThenBy(group => group.FilePath))
                                {
                                    <div class="pref-row-desc">@TrustImpactLabel(group.Impact): @HealthGroupLabel(group) (@group.Count)</div>
                                }
                            </details>
                        }
                        <details class="content-information">
                            <summary>Database check details</summary>
                            <div class="pref-row-desc">Checks normalized records and import diagnostics. Prepared XML loading and definition comparisons are checked separately; this check does not certify Legacy behavior.</div>
                            <div class="pref-row-desc">Actionable unresolved links: @_dbHealth.ActionableUnresolvedLinks</div>
                            <div class="pref-row-desc">Classified unresolved links: @_dbHealth.ClassifiedUnresolvedLinks</div>
                            <div class="pref-row-desc">Source integrity issues: @_dbHealth.SourceIntegrityIssues</div>
                            <div class="pref-row-desc">Missing spell rows: @_dbHealth.MissingResolvedSpellRows</div>
                            <div class="pref-row-desc">Missing item rows: @_dbHealth.MissingResolvedItemRows</div>
                            <div class="pref-row-desc">Missing companion rows: @_dbHealth.MissingResolvedCompanionRows</div>
                        </details>
                    </div>
                }

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.ContentCopy"
                           Style="margin-bottom: 16px;"
                           Disabled="@(_dbHealth is null && _dbMetadata is null && _dbParity is null && _diagnosticsProblem is null)"
                           OnClick="CopyContentDiagnosticsAsync">
                    Copy Diagnostics
                </MudButton>

                <div style="margin-bottom: 16px;">
                    <div class="pref-row-title" style="margin-bottom: 6px;">Database vs XML parity</div>
                    <div class="pref-row-desc" style="margin-bottom: 10px;">
                        Compares prepared XML definitions with the SQLite reconstruction, including rules and descriptions.
                        Both sides honor the importer's content decisions. This checks the current catalog and does not
                        prove identical character behavior in the Legacy app. It runs only when requested.
                    </div>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               Size="Size.Small"
                               Disabled="@(_parityRunning || _reloadingElements || ContentDb.SyncState == ContentDatabaseSyncState.Syncing)"
                               OnClick="RunParityAuditAsync">
                        @(_parityRunning ? "Running parity audit..." : "Run Parity Audit")
                    </MudButton>
                </div>

                @if (_dbParity != null)
                {
                    <div style="margin-bottom: 16px;">
                        <MudAlert Severity="@ParitySeverity(_dbParity)"
                                  Dense="true"
                                  Variant="Variant.Outlined"
                                  Class="mb-2">
                            @ParitySummary(_dbParity)
                        </MudAlert>
                        @if (_dbParity.Success)
                        {
                            <div class="pref-row-desc">XML elements: @_dbParity.XmlElementCount</div>
                            <div class="pref-row-desc">Database elements: @_dbParity.DatabaseElementCount</div>
                            <div class="pref-row-desc">XML skipped during audit: @_dbParity.XmlSkippedElements</div>
                            <div class="pref-row-desc">Database skipped during audit: @_dbParity.DatabaseSkippedElements</div>
                            <div class="pref-row-desc">Missing from DB: @_dbParity.MissingInDatabaseCount</div>
                            <div class="pref-row-desc">Missing from XML: @_dbParity.MissingInXmlCount</div>
                            <div class="pref-row-desc">Different definitions: @_dbParity.DefinitionMismatchCount</div>
                            @if (_dbParity.DefinitionMismatches.Count > 0)
                            {
                                <div class="pref-row-title" style="margin-top: 10px; margin-bottom: 4px;">Different definitions (sample)</div>
                                @foreach (string id in _dbParity.DefinitionMismatches)
                                {
                                    <div class="pref-row-desc" style="font-family: monospace;">@id</div>
                                }
                            }
                            @if (_dbParity.MissingInDatabaseSample.Count > 0)
                            {
                                <div class="pref-row-title" style="margin-top: 10px; margin-bottom: 4px;">XML entries missing from DB (sample)</div>
                                @foreach (string id in _dbParity.MissingInDatabaseSample)
                                {
                                    <div class="pref-row-desc" style="font-family: monospace;">@id</div>
                                }
                            }
                            @if (_dbParity.MissingInXmlSample.Count > 0)
                            {
                                <div class="pref-row-title" style="margin-top: 10px; margin-bottom: 4px;">Present in DB but missing from XML (sample)</div>
                                @foreach (string id in _dbParity.MissingInXmlSample)
                                {
                                    <div class="pref-row-desc" style="font-family: monospace;">@id</div>
                                }
                            }
                            @if (_dbParity.TypeMismatches.Count > 0)
                            {
                                <div class="pref-row-title" style="margin-top: 10px; margin-bottom: 4px;">Type count mismatches</div>
                                @foreach (var mismatch in _dbParity.TypeMismatches)
                                {
                                    <div class="pref-row-desc">@mismatch.Key: XML @mismatch.XmlCount, DB @mismatch.DatabaseCount</div>
                                }
                            }
                            @if (_dbParity.SourceMismatches.Count > 0)
                            {
                                <div class="pref-row-title" style="margin-top: 10px; margin-bottom: 4px;">Source count mismatches</div>
                                @foreach (var mismatch in _dbParity.SourceMismatches)
                                {
                                    <div class="pref-row-desc">@mismatch.Key: XML @mismatch.XmlCount, DB @mismatch.DatabaseCount</div>
                                }
                            }
                        }
                        else if (!string.IsNullOrWhiteSpace(_dbParity.FailureReason))
                        {
                            <div class="pref-row-desc">@_dbParity.FailureReason</div>
                        }
                    </div>
                }
            </div>
        }

    </MudTabPanel>

</MudTabs>

@code {
    [SupplyParameterFromQuery(Name = "tab")]
    public string? RequestedTab { get; set; }

    private bool _disposed;
    private string _indexUrl = "";
    private string _newDirPath = "";
    private string? _contentStatus;
    private Severity _contentStatusSeverity = Severity.Success;
    private bool _contentWorking;
    private bool _checkingUpdates;
    private bool _checkingReleaseChannels;
    private bool _parityRunning;
    private bool _stalenessChecked;
    private bool _checkingStale;
    private bool _reloadingElements;
    private bool _needsContentReload;
    private ContentDatabaseHealthReport? _dbHealth;
    private ContentDatabaseMetadata? _dbMetadata;
    private ContentDatabaseParityReport? _dbParity;
    private CancellationTokenSource? _parityCancellation;
    private int _diagnosticsRequest;
    private string? _diagnosticsProblem;
    private bool _dirBusy;
    private string? _dirError;

    private AppThemeDefinition SelectedTheme => AppThemes.Get(Prefs.Theme);

    private int ActiveSettingsTabIndex
    {
        get => PageState.Settings.ActiveSettingsTabIndex;
        set => PageState.Settings.ActiveSettingsTabIndex = value;
    }

    private int ActiveContentTabIndex
    {
        get => PageState.Settings.ActiveContentTabIndex;
        set => PageState.Settings.ActiveContentTabIndex = value;
    }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(RequestedTab))
        {
            return;
        }

        ActiveSettingsTabIndex = RequestedTab.ToLowerInvariant() switch
        {
            "general" => 0,
            "character-sheet" or "sheet" => 1,
            "content" => 2,
            "updates" => 3,
            "advanced" => 4,
            _ => 0
        };
    }

    protected override async Task OnInitializedAsync()
    {
        ContentDb.StateChanged += OnStateChanged;
        Content.Changed += OnContentChanged;
        AppUpdates.Changed += OnAppUpdatesChanged;
        Prefs.DeveloperModeChanged += OnDeveloperModeChanged;
        await RefreshDatabaseDiagnosticsAsync();
    }

    private void OnAppUpdatesChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(() => { if (!_disposed) StateHasChanged(); });
    }

    private void OnDeveloperModeChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;
            InvalidateDiagnostics();
            if (Prefs.DevMode) await RefreshDatabaseDiagnosticsAsync();
            if (!_disposed) StateHasChanged();
        });
    }

    private Task CheckAppReleaseNowAsync() =>
