@* Editable text field for narrative/appearance data on the Background build tab. *@

<Aurora.Components.Shared.CharacterNarrativeField Label="@Label" Value="@Value" Lines="Lines"
                                                 ValueChanged="ValueChanged" OnCommitted="OnCommitted" />

@code {
    [Parameter] public string  Label        { get; set; } = "";
    [Parameter] public string  Value        { get; set; } = "";
    [Parameter] public int     Lines        { get; set; } = 1;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public EventCallback OnCommitted { get; set; }
}
