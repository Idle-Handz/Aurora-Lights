@code {
    [Parameter, EditorRequired]
    public MagicOverviewModel Model { get; set; } = new();

    [Parameter]
    public string? SelectedSpellId { get; set; }

    [Parameter]
    public MagicSpellDetailModel? SelectedSpell { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public EventCallback<string> OnSelectSpell { get; set; }

    [Parameter]
    public EventCallback<string> OnChangeKnownSpell { get; set; }

    [Parameter]
    public EventCallback<MagicPreparedChangeModel> OnPreparedChanged { get; set; }

    [Parameter]
    public EventCallback<MagicSlotToggleModel> OnToggleSlot { get; set; }

    private const string KnownTabId = "known";
    private const string CastableTabId = "castable";

    private string _knownSearchText = string.Empty;
    private string _knownLevelFilter = string.Empty;
    private string _knownSourceFilter = string.Empty;
    private string _knownSchoolFilter = string.Empty;
    private string _knownCastingTimeFilter = string.Empty;
    private bool _knownRitualOnly;
    private bool _knownConcentrationOnly;
    private string _castableSearchText = string.Empty;
    private string _castableLevelFilter = string.Empty;
    private string _castableSourceFilter = string.Empty;
    private string _castableSchoolFilter = string.Empty;
    private string _castableCastingTimeFilter = string.Empty;
    private bool _castableRitualOnly;
    private bool _castableConcentrationOnly;
    private string _preparedSearchText = string.Empty;
    private string _preparedLevelFilter = string.Empty;
    private string _preparedSourceFilter = string.Empty;
    private string _preparedSchoolFilter = string.Empty;
    private string _preparedCastingTimeFilter = string.Empty;
    private bool _preparedOnly;
    private bool _preparedRitualOnly;
    private bool _preparedConcentrationOnly;
    // Selected tab: all castable spells, known spells, or a prepared-caster section id. Each
    // prepared-casting class gets its own "Prepared — <class>" tab.
    private string _selectedTab = CastableTabId;
    private readonly HashSet<string> _collapsedGroups = new(StringComparer.Ordinal);
    private readonly HashSet<int> _collapsedLevels = new();
    private IReadOnlyList<MagicSpellcastingSectionModel> _castableSections = [];

    // Prepared-caster sections, each of which gets a Prepared tab.
    private IReadOnlyList<MagicSpellcastingSectionModel> PreparedSections =>
        Model.Sections.Where(s => s.IsPreparedCaster).ToList();

    // The section backing the active Prepared tab (or the primary section as a fallback, e.g. for
    // the Known tab's stats strip).
    private MagicSpellcastingSectionModel ActiveSection =>
        Model.Sections.FirstOrDefault(section => section.Id == _selectedTab)
        ?? Model.Sections.FirstOrDefault()
        ?? new MagicSpellcastingSectionModel();

    private bool OnKnownTab => _selectedTab == KnownTabId
        || (_selectedTab != CastableTabId && !Model.Sections.Any(s => s.Id == _selectedTab));

    private bool OnCastableTab => _selectedTab == CastableTabId && HasCastableSpells;

    private bool HasCastableSpells =>
        _castableSections.Any(section =>
            section.Cantrips.Count > 0
            || section.SpellLevels.SelectMany(level => level.Spells)
                .Any(CanCastNow));

    // Spell slots are a single shared pool across all of a character's casting classes (multiclass
    // caster table), so aggregate every section's per-level slots into one combined bar.
    private IReadOnlyList<MagicSpellLevelModel> CombinedSlots =>
        Model.Sections
            .SelectMany(s => s.SpellLevels)
            .Where(l => l.TotalSlots > 0)
            .GroupBy(l => l.Level)
            .Select(g => new MagicSpellLevelModel(g.Key, [], g.Max(l => l.TotalSlots), g.Max(l => l.UsedSlots)))
            .OrderBy(l => l.Level)
            .ToList();

    // Known-view filtering. Each entry carries its resolved spell metadata (source/school/ritual/
    // concentration, looked up by spell id in the page), so the full filter bar works here too.
    // State is shared with the Prepared browse so a search carries across tabs. Empty groups drop out.
    private bool KnownEntryMatches(MagicKnownSpellEntryModel ent)
    {
        if (!string.IsNullOrWhiteSpace(_knownSearchText)
            && !(ent.CurrentName ?? "").Contains(_knownSearchText, StringComparison.OrdinalIgnoreCase)
            && !(ent.Label ?? "").Contains(_knownSearchText, StringComparison.OrdinalIgnoreCase))
            return false;
        if (!string.IsNullOrWhiteSpace(_knownLevelFilter)
            && int.TryParse(_knownLevelFilter, out int lf) && ent.SpellLevel != lf)
            return false;
        if (!string.IsNullOrWhiteSpace(_knownSourceFilter)
            && !string.Equals(ent.Source, _knownSourceFilter, StringComparison.OrdinalIgnoreCase))
            return false;
        if (!string.IsNullOrWhiteSpace(_knownSchoolFilter)
            && !string.Equals(ent.School, _knownSchoolFilter, StringComparison.OrdinalIgnoreCase))
            return false;
        if (!MatchesCastingTimeFilter(ent.CastingTime, _knownCastingTimeFilter))
            return false;
        if (_knownRitualOnly && !ent.IsRitual)
            return false;
        if (_knownConcentrationOnly && !ent.IsConcentration)
            return false;
        return true;
    }

    private IEnumerable<(MagicKnownSpellGroupModel Group, IReadOnlyList<MagicKnownSpellEntryModel> Entries)> FilterKnownGroups(
        IEnumerable<MagicKnownSpellGroupModel> groups) =>
        groups
            .Select(g => (Group: g, Entries: (IReadOnlyList<MagicKnownSpellEntryModel>)g.Entries.Where(KnownEntryMatches).ToList()))
            .Where(x => x.Entries.Count > 0);

    private IReadOnlyList<MagicSpellLevelModel> FilteredSpellLevels =>
        ActiveSection.SpellLevels
            .Select(level => new MagicSpellLevelModel(
                level.Level,
                level.Spells.Where(MatchesSpellFilter).ToList(),
                level.TotalSlots,
                level.UsedSlots))
            .Where(level => level.Spells.Count > 0 || LevelShouldRemainVisible(level.Level))
            .ToList();

    private IReadOnlyList<MagicSpellcastingSectionModel> FilteredCastableSections =>
        _castableSections
            .Where(section => GetCastableCantrips(section).Count > 0 || GetCastableSpellLevels(section).Count > 0)
            .ToList();

    private IReadOnlyList<MagicSpellListEntryModel> GetCastableCantrips(MagicSpellcastingSectionModel section) =>
        section.Cantrips
            .Where(MatchesCastableSpellFilter)
            .ToList();

    private IReadOnlyList<MagicSpellLevelModel> GetCastableSpellLevels(MagicSpellcastingSectionModel section) =>
        section.SpellLevels
            .Select(level => new MagicSpellLevelModel(
                level.Level,
                level.Spells
                    .Where(spell => CanCastNow(spell) && MatchesCastableSpellFilter(spell))
                    .ToList(),
                level.TotalSlots,
                level.UsedSlots))
            .Where(level => level.Spells.Count > 0)
            .ToList();

    private IReadOnlyList<MagicSpellcastingSectionModel> BuildCastableSections()
    {
        List<MagicSpellcastingSectionModel> sections = Model.Sections.ToList();
        HashSet<string> existingSpellKeys = Model.Sections
            .SelectMany(section => section.Cantrips.Concat(section.SpellLevels.SelectMany(level => level.Spells)))
            .Select(spell => GetSpellKey(spell.Id, spell.Name, spell.Level))
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        List<MagicSpellListEntryModel> projectedSpells = Model.KnownSpellGroups
            .SelectMany(group => group.Entries.Select(entry => (
                Group: group,
                Entry: entry,
                Access: group.ReadOnlyGroup ? MagicSpellSelectionAccess.Granted : entry.SelectionAccess)))
            .Where(pair => !string.IsNullOrWhiteSpace(pair.Entry.CurrentName))
            .Where(pair => pair.Access is MagicSpellSelectionAccess.Known
                or MagicSpellSelectionAccess.AlwaysPrepared
                or MagicSpellSelectionAccess.Granted
                or MagicSpellSelectionAccess.RitualBook)
            .Where(pair => pair.Access != MagicSpellSelectionAccess.RitualBook || pair.Entry.IsRitual)
            .Where(pair => !existingSpellKeys.Contains(GetSpellKey(
                pair.Entry.SpellId,
                pair.Entry.CurrentName!,
                pair.Entry.SpellLevel)))
            .GroupBy(
                pair => GetSpellKey(pair.Entry.SpellId, pair.Entry.CurrentName!, pair.Entry.SpellLevel),
                StringComparer.OrdinalIgnoreCase)
            .Select(group =>
            {
                var first = group.First();
                IReadOnlyList<MagicSpellAccessPathModel> paths = group
                    .Select(pair => CreateProjectedAccessPath(pair.Group, pair.Entry, pair.Access))
                    .Distinct()
                    .ToList();
                MagicSpellDisplayState state = paths.Any(path => path.Kind == MagicSpellAccessKind.AlwaysPrepared)
                    ? MagicSpellDisplayState.AlwaysPrepared
                    : paths.Any(path => path.Kind == MagicSpellAccessKind.Granted)
                        ? MagicSpellDisplayState.Granted
                        : paths.Any(path => path.Kind == MagicSpellAccessKind.Known)
                            ? MagicSpellDisplayState.Known
                            : MagicSpellDisplayState.Available;

                return new MagicSpellListEntryModel(
                    first.Entry.SpellId ?? first.Entry.Id,
                    first.Entry.CurrentName!,
                    first.Entry.SpellLevel,
                    first.Entry.Source,
                    first.Entry.School,
                    first.Entry.IsRitual,
                    first.Entry.IsConcentration,
                    isPrepared: false,
                    isAlwaysPrepared: false,
                    isCantrip: first.Entry.SpellLevel == 0,
                    displayState: state,
                    castingTime: first.Entry.CastingTime,
                    grantedBy: first.Entry.GrantedBy,
                    accessPaths: paths);
            })
            .OrderBy(spell => spell.Level)
            .ThenBy(spell => spell.Name)
            .ToList();

        if (projectedSpells.Count == 0)
        {
            return sections;
        }

        sections.Add(new MagicSpellcastingSectionModel
        {
            Id = "other-magic-sources",
            Label = "Other Magic Sources",
            Cantrips = projectedSpells.Where(spell => spell.Level == 0).ToList(),
            SpellLevels = projectedSpells
                .Where(spell => spell.Level > 0)
                .GroupBy(spell => spell.Level)
                .OrderBy(group => group.Key)
                .Select(group => new MagicSpellLevelModel(group.Key, group.ToList(), 0, 0))
                .ToList()
        });

        return sections;
    }

    private static MagicSpellAccessPathModel CreateProjectedAccessPath(
        MagicKnownSpellGroupModel group,
        MagicKnownSpellEntryModel entry,
        MagicSpellSelectionAccess access)
    {
        string source = FirstNonEmpty(entry.AccessSource, entry.GrantedBy, group.Label, "Feature");
        MagicSpellAccessKind kind = access switch
        {
            MagicSpellSelectionAccess.Known => MagicSpellAccessKind.Known,
            MagicSpellSelectionAccess.AlwaysPrepared => MagicSpellAccessKind.AlwaysPrepared,
            MagicSpellSelectionAccess.RitualBook => MagicSpellAccessKind.RitualBook,
            _ => MagicSpellAccessKind.Granted,
        };

        return new MagicSpellAccessPathModel(
            kind,
            group.SectionId ?? string.Empty,
            source,
            CanCastNormally: kind != MagicSpellAccessKind.RitualBook,
            CanCastAsRitual: kind == MagicSpellAccessKind.RitualBook);
    }

    private static bool CanCastNow(MagicSpellListEntryModel spell) =>
        spell.IsCantrip
        || spell.IsPrepared
        || spell.IsAlwaysPrepared
        || spell.AccessPaths.Any(path => path.CanCastNormally || path.CanCastAsRitual);

    private static string GetSpellKey(string? id, string name, int level) =>
        string.IsNullOrWhiteSpace(id)
            ? $"name:{level}:{name}"
            : $"id:{id}";

    // Editable spell-selection groups (cantrips + chosen known spells). The Known tab is unified
    // across all the character's casting classes, so all non-read-only groups show (grouped by class
    // via their own labels). Read-only granted groups are surfaced separately.
    private IReadOnlyList<MagicKnownSpellGroupModel> FilteredKnownSpellGroups =>
        Model.KnownSpellGroups
            .Where(group => !group.ReadOnlyGroup)
            .ToList();

    // Read-only spells granted by feats/items/species (e.g. dragonmark spells). They stay in Known
    // for provenance and are also projected into the All view as castable Granted spells.
    private IReadOnlyList<MagicKnownSpellGroupModel> ReadOnlyKnownGroups =>
        Model.KnownSpellGroups.Where(group => group.ReadOnlyGroup).ToList();

    private IReadOnlyList<string> _availableSources = [];
    private IReadOnlyList<string> _availableSchools = [];

    private void RefreshFilterLists()
    {
        // Cover every caster section's spells AND the known/granted entries, so the source/school
        // dropdowns are meaningful on both the combined Known tab and each Prepared tab.
        var sectionSpells = _castableSections
            .SelectMany(s => s.Cantrips.Concat(s.SpellLevels.SelectMany(l => l.Spells)));
        var knownEntries = Model.KnownSpellGroups.SelectMany(g => g.Entries);

        _availableSources = sectionSpells.Select(s => s.Source)
            .Concat(knownEntries.Select(e => e.Source))
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(s => s)
            .ToList();
        _availableSchools = sectionSpells.Select(s => s.School)
            .Concat(knownEntries.Select(e => e.School))
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(s => s)
            .ToList();
    }

    protected override void OnParametersSet()
    {
        _castableSections = BuildCastableSections();

        // Reset to the Known tab if the selected Prepared section is gone (or never existed).
        if (_selectedTab != KnownTabId && _selectedTab != CastableTabId && !Model.Sections.Any(section => section.Id == _selectedTab))
            _selectedTab = KnownTabId;
        if (_selectedTab == CastableTabId && !HasCastableSpells)
            _selectedTab = KnownTabId;

        RefreshFilterLists();
    }

    private void SelectTab(string tab)
    {
        _selectedTab = tab;
        _collapsedGroups.Clear();
        _collapsedLevels.Clear();
        RefreshFilterLists();
    }

    private void ToggleGroupCollapse(string key)
    {
        if (!_collapsedGroups.Remove(key))
            _collapsedGroups.Add(key);
    }

    private void ToggleLevel(int level)
    {
        if (!_collapsedLevels.Remove(level))
            _collapsedLevels.Add(level);
    }

    private bool MatchesSpellFilter(MagicSpellListEntryModel spell)
    {
        if (!string.IsNullOrWhiteSpace(_preparedSearchText))
        {
            bool matchesText =
                spell.Name.Contains(_preparedSearchText, StringComparison.OrdinalIgnoreCase) ||
                (!string.IsNullOrWhiteSpace(spell.Source) &&
                 spell.Source.Contains(_preparedSearchText, StringComparison.OrdinalIgnoreCase));

            if (!matchesText) return false;
        }

        if (!string.IsNullOrWhiteSpace(_preparedLevelFilter) &&
            int.TryParse(_preparedLevelFilter, out int levelFilter) &&
            spell.Level != levelFilter)
        {
            return false;
        }

        if (_preparedOnly && !spell.IsPrepared && !spell.IsAlwaysPrepared)
            return false;

        if (!string.IsNullOrWhiteSpace(_preparedSourceFilter)
            && !string.Equals(spell.Source, _preparedSourceFilter, StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrWhiteSpace(_preparedSchoolFilter)
            && !string.Equals(spell.School, _preparedSchoolFilter, StringComparison.OrdinalIgnoreCase))
            return false;
        if (!MatchesCastingTimeFilter(spell.CastingTime, _preparedCastingTimeFilter))
            return false;

        if (_preparedRitualOnly && !spell.IsRitual)
            return false;

        if (_preparedConcentrationOnly && !spell.IsConcentration)
            return false;

        return true;
    }

    private bool MatchesCastableSpellFilter(MagicSpellListEntryModel spell)
    {
        if (!string.IsNullOrWhiteSpace(_castableSearchText))
        {
            bool matchesText =
                spell.Name.Contains(_castableSearchText, StringComparison.OrdinalIgnoreCase) ||
                (!string.IsNullOrWhiteSpace(spell.Source) &&
                 spell.Source.Contains(_castableSearchText, StringComparison.OrdinalIgnoreCase));

            if (!matchesText) return false;
        }

        if (!string.IsNullOrWhiteSpace(_castableLevelFilter) &&
            int.TryParse(_castableLevelFilter, out int levelFilter) &&
            spell.Level != levelFilter)
        {
            return false;
        }

        if (!string.IsNullOrWhiteSpace(_castableSourceFilter)
            && !string.Equals(spell.Source, _castableSourceFilter, StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrWhiteSpace(_castableSchoolFilter)
            && !string.Equals(spell.School, _castableSchoolFilter, StringComparison.OrdinalIgnoreCase))
            return false;
        if (!MatchesCastingTimeFilter(spell.CastingTime, _castableCastingTimeFilter))
            return false;

        if (_castableRitualOnly && !spell.IsRitual)
            return false;

        if (_castableConcentrationOnly && !spell.IsConcentration)
            return false;

        return true;
    }

    private static bool MatchesCastingTimeFilter(string castingTime, string filter)
    {
        if (string.IsNullOrWhiteSpace(filter))
        {
            return true;
        }

        if (string.IsNullOrWhiteSpace(castingTime))
        {
            return false;
        }

        string normalized = castingTime.Trim().ToLowerInvariant();
        string category = normalized switch
        {
            _ when normalized.Contains("bonus action", StringComparison.Ordinal) => "bonus-action",
            _ when normalized.Contains("reaction", StringComparison.Ordinal) => "reaction",
            "action" => "action",
            _ when normalized.StartsWith("1 action", StringComparison.Ordinal) => "action",
            _ when normalized.StartsWith("an action", StringComparison.Ordinal) => "action",
            _ => "longer",
        };

        return string.Equals(category, filter, StringComparison.Ordinal);
    }

    private bool LevelShouldRemainVisible(int level)
        => !string.IsNullOrWhiteSpace(_preparedLevelFilter)
           && int.TryParse(_preparedLevelFilter, out int levelFilter)
           && level == levelFilter;

    private bool IsPreparationDisabled(MagicSpellListEntryModel spell)
    {
        if (!OnPreparedChanged.HasDelegate || Busy || spell.IsAlwaysPrepared)
        {
            return true;
        }

        return !spell.IsPrepared
               && ActiveSection.IsPreparedCaster
               && ActiveSection.MaxPrepared > 0
               && ActiveSection.PreparedCount >= ActiveSection.MaxPrepared;
    }

    private Task ChangePreparedAsync(string spellId, ChangeEventArgs args)
    {
        if (!OnPreparedChanged.HasDelegate) return Task.CompletedTask;
        bool value = args.Value is bool b && b;
        return OnPreparedChanged.InvokeAsync(
            new MagicPreparedChangeModel(spellId, value, ActiveSection.Id, ActiveSection.Label));
    }

    private static IEnumerable<(string Label, string Value)> GetSpellProperties(MagicSpellDetailModel spell)
    {
        if (!string.IsNullOrWhiteSpace(spell.CastingTime))
            yield return ("Casting Time", spell.CastingTime);
        if (!string.IsNullOrWhiteSpace(spell.Range))
            yield return ("Range", spell.Range);
        if (!string.IsNullOrWhiteSpace(spell.Components))
            yield return ("Components", spell.Components);
        if (!string.IsNullOrWhiteSpace(spell.Duration))
            yield return ("Duration", spell.Duration);
    }

    private static string Ordinal(int level) => level switch
    {
        1 => "1st",
        2 => "2nd",
        3 => "3rd",
        _ => $"{level}th",
    };

    private static IReadOnlyList<(string Label, string CssClass)> GetPreparedAccessBadges(
        MagicSpellListEntryModel spell,
        MagicSpellcastingSectionModel section)
    {
        var badges = new List<(string Label, string CssClass)>();

        if (spell.IsAlwaysPrepared)
        {
            MagicSpellAccessPathModel? localAlways = spell.AccessPaths.FirstOrDefault(path =>
                path.Kind == MagicSpellAccessKind.AlwaysPrepared
                && string.Equals(path.CastingSectionId, section.Id, StringComparison.OrdinalIgnoreCase));
            string source = FirstNonEmpty(localAlways?.SourceLabel, spell.GrantedBy);
            badges.Add((AppendSource("Always Prepared", source), "magic-spell-badge-always"));
        }
        else
        {
            badges.Add(spell.IsPrepared
                ? ("Prepared", "magic-spell-badge-prepared")
                : ("Available", "magic-spell-badge-available"));
        }

        IEnumerable<MagicSpellAccessPathModel> supplementalPaths = spell.AccessPaths
            .Where(path => path.CanCastNormally)
            .Where(path => !IsSupersededAccessPath(spell, path))
            .Where(path => !IsRepresentedByLocalPreparation(path, spell, section.Id))
            .DistinctBy(path => $"{path.Kind}|{path.CastingSectionId}|{path.SourceLabel}",
                StringComparer.OrdinalIgnoreCase);

        badges.AddRange(supplementalPaths.Select(path => (
            GetAccessPathLabel(path, section.Id, preparedContext: true),
            GetAccessPathBadgeClass(path.Kind))));

        return badges
            .DistinctBy(badge => badge.Label, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static (string Label, string CssClass) GetKnownEntryAccessBadge(
        MagicKnownSpellGroupModel group,
        MagicKnownSpellEntryModel entry)
    {
        MagicSpellSelectionAccess access = group.ReadOnlyGroup
            ? MagicSpellSelectionAccess.Granted
            : entry.SelectionAccess;
        string source = FirstNonEmpty(entry.AccessSource, entry.GrantedBy, group.Label);

        return access switch
        {
            MagicSpellSelectionAccess.Known =>
                (AppendSource("Known", source), "magic-spell-badge-known"),
            MagicSpellSelectionAccess.AlwaysPrepared =>
                (AppendSource("Always Prepared", source), "magic-spell-badge-always"),
            MagicSpellSelectionAccess.Granted =>
                (AppendSource("Granted", source), "magic-spell-badge-granted"),
            MagicSpellSelectionAccess.Spellbook =>
                (AppendSource("Spellbook", source), "magic-spell-badge-available"),
            MagicSpellSelectionAccess.RitualBook =>
                (AppendSource("Ritual Only", source), "magic-spell-badge-ritual"),
            _ =>
                (AppendSource("Preparable", source), "magic-spell-badge-available"),
        };
    }

    private static IReadOnlyList<(string Label, string CssClass)> GetCastableAccessBadges(
        MagicSpellListEntryModel spell,
        string sectionId)
    {
        List<(string Label, string CssClass)> badges = spell.AccessPaths
            .Where(path => path.CanCastNormally)
            .Where(path => !IsSupersededAccessPath(spell, path))
            .DistinctBy(path => $"{path.Kind}|{path.CastingSectionId}|{path.SourceLabel}",
                StringComparer.OrdinalIgnoreCase)
            .Select(path => (
                GetAccessPathLabel(path, sectionId, preparedContext: false),
                GetAccessPathBadgeClass(path.Kind)))
            .ToList();

        if (badges.Count == 0)
        {
            if (spell.IsAlwaysPrepared)
            {
                badges.Add((
                    AppendSource("Always Prepared", spell.GrantedBy),
                    "magic-spell-badge-always"));
            }
            else if (spell.IsPrepared)
            {
                badges.Add(("Prepared", "magic-spell-badge-prepared"));
            }
            else if (spell.IsCantrip)
            {
                badges.Add(("Known", "magic-spell-badge-known"));
            }
        }

        return badges
            .DistinctBy(badge => badge.Label, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static IReadOnlyList<(string Label, string CssClass)> GetRitualBadges(
        MagicSpellListEntryModel spell)
    {
        if (!spell.IsRitual)
        {
            return [];
        }

        List<MagicSpellAccessPathModel> ritualPaths = spell.AccessPaths
            .Where(path => path.CanCastAsRitual)
            .DistinctBy(path => path.SourceLabel, StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (ritualPaths.Count == 0)
        {
            return [("Ritual", string.Empty)];
        }

        bool canCastNormally = spell.IsPrepared
            || spell.IsAlwaysPrepared
            || spell.AccessPaths.Any(path => path.CanCastNormally);
        string prefix = canCastNormally ? "Ritual Available" : "Ritual Only";

        return ritualPaths
            .Select(path => (
                AppendSource(prefix, path.SourceLabel),
                "magic-spell-badge-ritual"))
            .DistinctBy(badge => badge.Item1, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static bool IsRepresentedByLocalPreparation(
        MagicSpellAccessPathModel path,
        MagicSpellListEntryModel spell,
        string sectionId) =>
        string.Equals(path.CastingSectionId, sectionId, StringComparison.OrdinalIgnoreCase)
        && ((spell.IsAlwaysPrepared && path.Kind == MagicSpellAccessKind.AlwaysPrepared)
            || (spell.IsPrepared && path.Kind == MagicSpellAccessKind.Prepared));

    private static bool IsSupersededAccessPath(
        MagicSpellListEntryModel spell,
        MagicSpellAccessPathModel path) =>
        path.Kind == MagicSpellAccessKind.Granted
        && spell.AccessPaths.Any(candidate =>
            candidate.Kind == MagicSpellAccessKind.AlwaysPrepared
            && string.Equals(
                candidate.SourceLabel,
                path.SourceLabel,
                StringComparison.OrdinalIgnoreCase));

    private static string GetAccessPathLabel(
        MagicSpellAccessPathModel path,
        string currentSectionId,
        bool preparedContext)
    {
        bool isCurrentSection = string.Equals(
            path.CastingSectionId,
            currentSectionId,
            StringComparison.OrdinalIgnoreCase);

        string label = path.Kind switch
        {
            MagicSpellAccessKind.Known when preparedContext => "Already Known",
            MagicSpellAccessKind.Known => "Known",
            MagicSpellAccessKind.Prepared when preparedContext && !isCurrentSection => "Already Prepared",
            MagicSpellAccessKind.Prepared => "Prepared",
            MagicSpellAccessKind.AlwaysPrepared => "Always Prepared",
            MagicSpellAccessKind.Granted => "Granted",
            _ => "Available",
        };

        return AppendSource(label, path.SourceLabel);
    }

    private static string GetAccessPathBadgeClass(MagicSpellAccessKind kind) => kind switch
    {
        MagicSpellAccessKind.AlwaysPrepared => "magic-spell-badge-always",
        MagicSpellAccessKind.Granted => "magic-spell-badge-granted",
        MagicSpellAccessKind.Known => "magic-spell-badge-known",
        MagicSpellAccessKind.Prepared => "magic-spell-badge-prepared",
        _ => "magic-spell-badge-available",
    };

    private static string AppendSource(string label, string? source) =>
        string.IsNullOrWhiteSpace(source) ? label : $"{label} — {source}";

    private static string FirstNonEmpty(params string?[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? string.Empty;

}
