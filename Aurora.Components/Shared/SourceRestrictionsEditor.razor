<div class="source-restrictions-editor">
    @if (ShowDefaultActions)
    {
        <div class="source-restrictions-toolbar">
            <button type="button"
                    class="source-restrictions-button"
                    @onclick="OnLoadDefaults"
                    disabled="@Busy">
                Load Default
            </button>
            <button type="button"
                    class="source-restrictions-button primary"
                    @onclick="OnSaveDefaults"
                    disabled="@Busy">
                Save as Default
            </button>
        </div>
    }

    <div class="source-restrictions-search-row">
        <input class="source-restrictions-search"
               type="search"
               placeholder="Filter sources…"
               value="@_search"
               @oninput="e => _search = e.Value?.ToString() ?? string.Empty" />
        @if (Searching)
        {
            <button type="button" class="source-restrictions-button" @onclick="() => _search = string.Empty">
                Clear
            </button>
        }
    </div>

    @foreach (SourceRestrictionNodeModel category in VisibleNodes)
    {
        bool expanded = IsExpanded(category);

        <section class="source-restrictions-node category @(expanded ? "expanded" : "collapsed")">
            <div class="source-restrictions-node-header">
                <button type="button"
                        class="source-restrictions-disclosure"
                        aria-expanded="@expanded.ToString().ToLowerInvariant()"
                        aria-label="@(expanded ? $"Collapse {category.Label}" : $"Expand {category.Label}")"
                        @onclick="() => ToggleExpanded(category)">
                    <span class="source-restrictions-chevron">@(expanded ? "▾" : "▸")</span>
                </button>

                <button type="button"
                        class="source-restrictions-toggle"
                        role="checkbox"
                        aria-checked="@GetAriaChecked(category.IsChecked)"
                        title="@(category.AllowUnchecking ? null : AlwaysEnabledTitle)"
                        @onclick="() => ToggleNodeAsync(category)"
                        disabled="@(Busy || !category.AllowUnchecking)">
                    <span class="source-restrictions-checkbox @GetCheckClass(category.IsChecked, category.AllowUnchecking)"></span>
                    <span class="source-restrictions-node-copy">
                        <strong>@category.Label</strong>
                        <small>@category.Description</small>
                    </span>
                    @if (category.AllowUnchecking)
                    {
                        <span class="source-restrictions-count">@category.EnabledCount / @category.TotalCount</span>
                    }
                    else
                    {
                        <span class="source-restrictions-core">Always enabled</span>
                    }
                </button>
            </div>

            @if (expanded)
            {
                <div class="source-restrictions-node-body">
                    @if (VisibleSources(category).Count > 0)
                    {
                        <div class="source-restrictions-items">
                            @foreach (SourceRestrictionItemModel item in VisibleSources(category))
                            {
                                @RenderSource(item)
                            }
                        </div>
                    }

                    @foreach (SourceRestrictionNodeModel publisher in VisibleChildren(category))
                    {
                        bool publisherExpanded = IsExpanded(publisher);

                        <section class="source-restrictions-node publisher @(publisherExpanded ? "expanded" : "collapsed")">
                            <div class="source-restrictions-node-header">
                                <button type="button"
                                        class="source-restrictions-disclosure"
                                        aria-expanded="@publisherExpanded.ToString().ToLowerInvariant()"
                                        aria-label="@(publisherExpanded ? $"Collapse {publisher.Label}" : $"Expand {publisher.Label}")"
                                        @onclick="() => ToggleExpanded(publisher)">
                                    <span class="source-restrictions-chevron">@(publisherExpanded ? "▾" : "▸")</span>
                                </button>

                                <button type="button"
                                        class="source-restrictions-toggle"
                                        role="checkbox"
                                        aria-checked="@GetAriaChecked(publisher.IsChecked)"
                                        @onclick="() => ToggleNodeAsync(publisher)"
                                        disabled="@Busy">
                                    <span class="source-restrictions-checkbox @GetCheckClass(publisher.IsChecked, allowUnchecking: true)"></span>
                                    <span class="source-restrictions-node-copy">
                                        <strong>@publisher.Label</strong>
                                    </span>
                                    <span class="source-restrictions-count">@publisher.EnabledCount / @publisher.TotalCount</span>
                                </button>
                            </div>

                            @if (publisherExpanded)
                            {
                                <div class="source-restrictions-items">
                                    @foreach (SourceRestrictionItemModel item in VisibleSources(publisher))
                                    {
                                        @RenderSource(item)
                                    }
                                </div>
                            }
                        </section>
                    }
                </div>
            }
        </section>
    }

    @if (VisibleNodes.Count == 0)
    {
        <p class="source-restrictions-empty">
            @(Searching ? $"No sources match \"{_search}\"." : "No sources are available.")
        </p>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<SourceRestrictionGroupModel> Groups { get; set; } = [];

    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public bool ShowDefaultActions { get; set; }

    /// <summary>Switches every source under a category or publisher on or off in one step.</summary>
    [Parameter]
    public EventCallback<SourceRestrictionNodeToggle> OnToggleNode { get; set; }

    [Parameter]
    public EventCallback<string> OnToggleItem { get; set; }

    [Parameter]
    public EventCallback OnLoadDefaults { get; set; }

    [Parameter]
    public EventCallback OnSaveDefaults { get; set; }

    private const string AlwaysEnabledTitle = "Required for the builder. Always enabled.";

    private string _search = "";

    // Collapsed on arrival: the whole catalog is over two hundred books, and the counts on each
    // category say what state it is in without opening it.
    private readonly HashSet<string> _expanded = new(StringComparer.Ordinal);

    private bool Searching => !string.IsNullOrWhiteSpace(_search);

    private IReadOnlyList<SourceRestrictionNodeModel> Tree => SourceRestrictionTreeBuilder.Build(Groups);

    private IReadOnlyList<SourceRestrictionNodeModel> VisibleNodes =>
        Tree.Where(node => !Searching || Matches(node)).ToList();

    /// <summary>A filter opens what it finds; otherwise the user's own expansions decide.</summary>
    private bool IsExpanded(SourceRestrictionNodeModel node) =>
        Searching ? Matches(node) : _expanded.Contains(node.Id);

    private void ToggleExpanded(SourceRestrictionNodeModel node)
    {
        if (!_expanded.Add(node.Id)) _expanded.Remove(node.Id);
    }

    private bool Matches(SourceRestrictionNodeModel node) =>
        !Searching
        || node.Label.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || node.AllSources.Any(source => source.Name.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private IReadOnlyList<SourceRestrictionNodeModel> VisibleChildren(SourceRestrictionNodeModel node) =>
        node.Children.Where(child => !Searching || Matches(child)).ToList();

    /// <summary>A node whose own label matches shows everything under it; otherwise only the hits.</summary>
    private IReadOnlyList<SourceRestrictionItemModel> VisibleSources(SourceRestrictionNodeModel node)
    {
        if (!Searching || node.Label.Contains(_search, StringComparison.OrdinalIgnoreCase))
            return node.Sources;

        return node.Sources
            .Where(source => source.Name.Contains(_search, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private Task ToggleNodeAsync(SourceRestrictionNodeModel node)
    {
        var ids = node.ToggleableSources.Select(source => source.Id).ToList();
        if (ids.Count == 0) return Task.CompletedTask;

        return OnToggleNode.InvokeAsync(new SourceRestrictionNodeToggle(
            node.Id, ids, node.IsChecked != true));
    }

    private RenderFragment RenderSource(SourceRestrictionItemModel item) =>
        @<button type="button"
                 class="source-restrictions-item @(item.AllowUnchecking ? string.Empty : "locked")"
                 role="checkbox"
                 aria-checked="@GetAriaChecked(item.IsChecked)"
                 title="@(item.AllowUnchecking ? null : AlwaysEnabledTitle)"
                 @onclick="() => OnToggleItem.InvokeAsync(item.Id)"
                 disabled="@(Busy || !item.AllowUnchecking)">
            <span class="source-restrictions-checkbox @GetCheckClass(item.IsChecked, item.AllowUnchecking)"></span>
            <span class="source-restrictions-item-name">@item.Name</span>
            @if (!item.AllowUnchecking)
            {
                <span class="source-restrictions-core">Always enabled</span>
            }
        </button>;

    private static string GetAriaChecked(bool? value) =>
        value?.ToString().ToLowerInvariant() ?? "mixed";

    private static string GetCheckClass(bool? value, bool allowUnchecking)
    {
        if (!allowUnchecking) return "checked locked";
        if (!value.HasValue)  return "mixed";
        return value.Value ? "checked" : "unchecked";
    }
}
