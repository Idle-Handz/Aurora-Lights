<div class="source-restrictions-editor">
    @if (ShowDefaultActions)
    {
        <div class="source-restrictions-toolbar">
            <button type="button"
                    class="source-restrictions-button"
                    @onclick="OnLoadDefaults"
                    disabled="@Busy">
                Load Default
            </button>
            <button type="button"
                    class="source-restrictions-button primary"
                    @onclick="OnSaveDefaults"
                    disabled="@Busy">
                Save as Default
            </button>
        </div>
    }

    <section class="source-restrictions-categories" aria-label="Broad source toggles">
        <div class="source-restrictions-categories-header">
            <strong>Broad source toggles</strong>
            <span>Enable or disable whole source families. Required core sources stay enabled.</span>
        </div>

        <div class="source-restrictions-category-grid">
            @foreach (BroadToggleModel toggle in BroadToggles)
            {
                <button type="button"
                        class="source-restrictions-category"
                        aria-checked="@GetAriaChecked(toggle.IsChecked)"
                        role="checkbox"
                        @onclick="() => ToggleCategoryAsync(toggle)"
                        disabled="@(Busy || toggle.TotalCount == 0)">
                    <span class="source-restrictions-checkbox @GetCheckClass(toggle.IsChecked, allowUnchecking: true)"></span>
                    <span class="source-restrictions-category-copy">
                        <strong>@toggle.Label</strong>
                        <small>@toggle.Description</small>
                    </span>
                    <span class="source-restrictions-count">@toggle.EnabledCount / @toggle.TotalCount</span>
                </button>
            }
        </div>
    </section>

    @* Search filter *@
    <div style="margin-bottom: 10px;">
        <input class="source-restrictions-search"
               type="search"
               placeholder="Filter sources…"
               value="@_search"
               @oninput="e => _search = e.Value?.ToString() ?? string.Empty" />
    </div>

    @foreach (SourceRestrictionGroupModel group in FilteredGroups)
    {
        int enabledCount = group.Sources.Count(s => s.IsChecked == true);
        var visibleItems = FilteredItems(group);
        if (visibleItems.Count == 0) continue;

        <section class="source-restrictions-group">
            <div class="source-restrictions-group-header">
                <button type="button"
                        class="source-restrictions-toggle"
                        @onclick="() => OnToggleGroup.InvokeAsync(group.Id)"
                        disabled="@(Busy || !group.AllowUnchecking)">
                    <span class="source-restrictions-checkbox @(GetCheckClass(group.IsChecked, group.AllowUnchecking))"></span>
                    <span style="display: flex; align-items: center; gap: 8px; flex: 1; min-width: 0;">
                        <strong>@group.Name</strong>
                        <span class="source-restrictions-count">@enabledCount / @group.Sources.Count</span>
                    </span>
                </button>
            </div>

            <div class="source-restrictions-items">
                @foreach (SourceRestrictionItemModel item in visibleItems)
                {
                    <button type="button"
                            class="source-restrictions-item @(item.AllowUnchecking ? string.Empty : "locked")"
                            @onclick="() => OnToggleItem.InvokeAsync(item.Id)"
                            disabled="@(Busy || !item.AllowUnchecking)">
                        <span class="source-restrictions-checkbox @(GetCheckClass(item.IsChecked, item.AllowUnchecking))"></span>
                        <span class="source-restrictions-item-name">@item.Name</span>
                        @if (item.IsCore)
                        {
                            <span class="source-restrictions-core">core</span>
                        }
                    </button>
                }
            </div>
        </section>
    }

    @if (FilteredGroups.All(g => FilteredItems(g).Count == 0))
    {
        <p style="color: #6c7086; font-size: 13px; padding: 8px 0;">No sources match "@_search".</p>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<SourceRestrictionGroupModel> Groups { get; set; } = [];

    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public bool ShowDefaultActions { get; set; }

    [Parameter]
    public EventCallback<SourceRestrictionCategoryToggle> OnToggleCategory { get; set; }

    [Parameter]
    public EventCallback<string> OnToggleGroup { get; set; }

    [Parameter]
    public EventCallback<string> OnToggleItem { get; set; }

    [Parameter]
    public EventCallback OnLoadDefaults { get; set; }

    [Parameter]
    public EventCallback OnSaveDefaults { get; set; }

    private string _search = "";

    private IReadOnlyList<BroadToggleModel> BroadToggles =>
        CategoryDefinitions.Select(definition =>
        {
            List<SourceRestrictionItemModel> items = Groups
                .SelectMany(group => group.Sources)
                .Where(item => item.AllowUnchecking && item.Category == definition.Category)
                .ToList();
            int enabledCount = items.Count(item => item.IsChecked == true);
            bool? isChecked = enabledCount == 0
                ? false
                : enabledCount == items.Count
                    ? true
                    : null;

            return new BroadToggleModel(
                definition.Category,
                definition.Label,
                definition.Description,
                isChecked,
                enabledCount,
                items.Count);
        }).ToList();

    private IReadOnlyList<SourceRestrictionGroupModel> FilteredGroups =>
        string.IsNullOrWhiteSpace(_search) ? Groups :
        Groups.Where(g => g.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                       || g.Sources.Any(s => s.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)))
              .ToList();

    private List<SourceRestrictionItemModel> FilteredItems(SourceRestrictionGroupModel group) =>
        string.IsNullOrWhiteSpace(_search) ? group.Sources.ToList() :
        group.Sources.Where(s => s.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                              || group.Name.Contains(_search, StringComparison.OrdinalIgnoreCase))
             .ToList();

    private Task ToggleCategoryAsync(BroadToggleModel toggle) =>
        OnToggleCategory.InvokeAsync(new SourceRestrictionCategoryToggle(
            toggle.Category,
            toggle.IsChecked != true));

    private static string GetAriaChecked(bool? value) =>
        value?.ToString().ToLowerInvariant() ?? "mixed";

    private static string GetCheckClass(bool? value, bool allowUnchecking)
    {
        if (!allowUnchecking) return "checked locked";
        if (!value.HasValue)  return "mixed";
        return value.Value ? "checked" : "unchecked";
    }

    private static readonly CategoryDefinition[] CategoryDefinitions =
    [
        new(SourceRestrictionCategory.ThirdParty, "3rd party", "Published third-party material"),
        new(SourceRestrictionCategory.Homebrew, "Homebrew", "Personal and community content"),
        new(SourceRestrictionCategory.Official5E, "5e official", "Official 2014-rules material"),
        new(SourceRestrictionCategory.Official55E, "5.5e official", "Official 2024-rules material")
    ];

    private sealed record CategoryDefinition(
        SourceRestrictionCategory Category,
        string Label,
        string Description);

    private sealed record BroadToggleModel(
        SourceRestrictionCategory Category,
        string Label,
        string Description,
        bool? IsChecked,
        int EnabledCount,
        int TotalCount);
}
