<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Aurora.Documents</AssemblyName>
    <RootNamespace>Aurora.Documents</RootNamespace>
    <AssemblyVersion>1.0.94.7407</AssemblyVersion>
    <FileVersion>1.0.94.7407</FileVersion>
    <Version>1.0.94.7407</Version>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="itextsharp">
      <HintPath>..\lib\itextsharp.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Aurora\Pages\equipment.pdf"
                      LogicalName="Aurora.Documents.Resources.Aurora.Pages.equipment.pdf" />
    <EmbeddedResource Include="Resources\Aurora\Pages\equipment_page.pdf"
                      LogicalName="Aurora.Documents.Resources.Aurora.Pages.equipment_page.pdf" />
    <EmbeddedResource Include="Resources\Aurora\Pages\notes_page.pdf"
                      LogicalName="Aurora.Documents.Resources.Aurora.Pages.notes_page.pdf" />
  </ItemGroup>

</Project>
