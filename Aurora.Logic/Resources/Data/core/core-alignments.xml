<?xml version="1.0" encoding="utf-8" ?>
<elements>
  <element name="Lawful Good" type="Alignment" source="Player’s Handbook" id="ID_ALIGNMENT_LAWFUL_GOOD">
    <supports/>
    <description><p>Lawful good (LG) creatures can be counted on to do the right thing as expected by society.</p>
</description>
<setters>
      <set name="Abbreviation">LG</set>
    </setters>
    <rules/>
  </element>
  <element name="Neutral Good" type="Alignment" source="Player’s Handbook" id="ID_ALIGNMENT_NEUTRAL_GOOD">
    <supports/>
    <description><p>Neutral good (NG) folk do the best they can to help others according to their needs.</p>
</description>
<setters>
      <set name="Abbreviation">NG</set>
    </setters>
    <rules/>
  </element>
  <element name="Chaotic Good" type="Alignment" source="Player’s Handbook" id="ID_ALIGNMENT_CHAOTIC_GOOD">
    <supports/>
    <description><p>Chaotic good (CG) creatures act as their conscience directs, with little regard for what others expect.</p>
</description>
<setters>
      <set name="Abbreviation">CG</set>
    </setters>
    <rules/>
  </element>
  <element name="Lawful Neutral" type="Alignment" source="Player’s Handbook" id="ID_ALIGNMENT_LAWFUL_NEUTRAL">
    <supports/>
    <description><p>Lawful neutral (LN) individuals act in accordance with law, tradition, or personal codes.</p>
</description>
<setters>
      <set name="Abbreviation">LW</set>
    </setters>
    <rules/>
  </element>
  <element name="Neutral" type="Alignment" source="Player’s Handbook" id="ID_ALIGNMENT_NEUTRAL">
    <supports/>
    <description><p>Neutral (N) is the alignment of those who prefer to steer clear of moral questions and don’t take sides, doing what seems best at the time.</p>
</description>
<setters>
      <set name="Abbreviation">N</set>
    </setters>
    <rules/>
  </element>
  <element name="Chaotic Neutral" type="Alignment" source="Player’s Handbook" id="ID_ALIGNMENT_CHAOTIC_NEUTRAL">
    <supports/>
    <description><p>Chaotic neutral (CN) creatures follow their whims, holding their personal freedom above all else.</p>
</description>
<setters>
      <set name="Abbreviation">CN</set>
    </setters>
    <rules/>
  </element>
  <element name="Lawful Evil" type="Alignment" source="Player’s Handbook" id="ID_ALIGNMENT_LAWFUL_EVIL">
    <supports/>
    <description><p>Lawful evil (LE) creatures methodically take what they want, within the limits of a code of tradition, loyalty, or order.</p>
</description>
<setters>
      <set name="Abbreviation">LE</set>
    </setters>
    <rules/>
  </element>
  <element name="Neutral Evil" type="Alignment" source="Player’s Handbook" id="ID_ALIGNMENT_NEUTRAL_EVIL">
    <supports/>
    <description><p>Neutral evil (NE) is the alignment of those who do whatever they can get away with, without compassion or qualms.</p>
</description>
<setters>
      <set name="Abbreviation">NE</set>
    </setters>
    <rules/>
  </element>
  <element name="Chaotic Evil" type="Alignment" source="Player’s Handbook" id="ID_ALIGNMENT_CHAOTIC_EVIL">
    <supports/>
    <description><p>Chaotic evil (CE) creatures act with arbitrary violence, spurred by their greed, hatred, or bloodlust.</p>
</description>
<setters>
      <set name="Abbreviation">CE</set>
    </setters>
    <rules/>
  </element>
</elements>