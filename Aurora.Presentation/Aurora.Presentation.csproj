<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Aurora.Presentation</AssemblyName>
    <RootNamespace>Aurora.Presentation</RootNamespace>
    <AssemblyVersion>1.0.82.7407</AssemblyVersion>
    <FileVersion>1.0.82.7407</FileVersion>
    <Version>1.0.82.7407</Version>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MahApps.Metro">
      <HintPath>..\lib\MahApps.Metro.dll</HintPath>
    </Reference>
    <Reference Include="System.Windows.Interactivity">
      <HintPath>..\lib\System.Windows.Interactivity.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Properties\Resources.resources"
                      LogicalName="Aurora.Presentation.Properties.Resources.resources" />
  </ItemGroup>

</Project>
