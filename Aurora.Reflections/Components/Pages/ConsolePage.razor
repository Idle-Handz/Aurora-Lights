@page "/console"
@implements IDisposable
@using System.Text
@inject DebugLogService Log
@inject UserPreferencesService Prefs
@inject IJSRuntime JS
@inject ISnackbar Snackbar
<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
    <MudText Typo="Typo.h5">Console</MudText>
    <MudStack Row="true" Spacing="1">
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.ContentCopy"
                   Disabled="@(_entries.Count == 0)"
                   OnClick="CopyLogAsync">
            Copy
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" OnClick="() => Log.Clear()">
            Clear
        </MudButton>
    </MudStack>
</div>

@if (_entries.Count == 0)
{
    <MudText Color="Color.Secondary" Style="font-size: 13px;">No log entries.</MudText>
}
else
{
    @if (_entries.Count > DisplayLimit)
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="margin-bottom: 8px; display: block;">
            Showing latest @DisplayLimit of @_entries.Count entries. Clear to reset.
        </MudText>
    }
    <div class="console-log" @ref="_logDiv">
        <Virtualize Items="@_displayed" Context="entry" OverscanCount="10" ItemSize="44">
            <div class="console-entry console-entry-@entry.Level.ToString().ToLowerInvariant()">
                <span class="console-ts">@entry.Timestamp.ToString("HH:mm:ss.fff")</span>
                <span class="console-level @LevelClass(entry.Level)">@LevelTag(entry.Level)</span>
                <span class="console-msg">@entry.Message</span>
                @if (!string.IsNullOrEmpty(entry.Details))
                {
                    <details class="console-details">
                        <summary>Details</summary>
                        <pre class="console-pre">@entry.Details</pre>
                    </details>
                }
            </div>
        </Virtualize>
    </div>
}

@code {
    private const int DisplayLimit = 200;

    private IReadOnlyList<LogEntry> _entries   = [];
    private List<LogEntry>          _displayed = [];
    private ElementReference        _logDiv;
    private bool                    _shouldScrollToTop;

    protected override void OnInitialized()
    {
        Log.Changed += OnLogChanged;
        UpdateEntries(Log.GetSnapshot());
        _shouldScrollToTop = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldScrollToTop)
        {
            _shouldScrollToTop = false;
            try { await JS.InvokeVoidAsync("scrollElementToTop", _logDiv); } catch { }
        }
    }

    private void OnLogChanged() => InvokeAsync(() =>
    {
        UpdateEntries(Log.GetSnapshot());
        _shouldScrollToTop = true;
        StateHasChanged();
    });

    private void UpdateEntries(IReadOnlyList<LogEntry> entries)
    {
        _entries   = entries;
        _displayed = entries.Count <= DisplayLimit
            ? entries.AsEnumerable().Reverse().ToList()
            : entries.Skip(entries.Count - DisplayLimit).Reverse().ToList();
    }

    private async Task CopyLogAsync()
    {
        if (_entries.Count == 0)
            return;

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", BuildLogText());
            Snackbar.Add($"Copied {_entries.Count} console entries.", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Could not copy console entries.", Severity.Error);
        }
    }

    private string BuildLogText()
    {
        var sb = new StringBuilder();
        foreach (var entry in _entries)
        {
            sb.Append('[')
              .Append(entry.Timestamp.ToString("yyyy-MM-dd HH:mm:ss.fff zzz"))
              .Append("] ")
              .Append(entry.Level.ToString().ToUpperInvariant())
              .Append(": ")
              .AppendLine(entry.Message);

            if (!string.IsNullOrWhiteSpace(entry.Details))
                sb.AppendLine(entry.Details.TrimEnd());
        }

        return sb.ToString().TrimEnd();
    }

    public void Dispose() => Log.Changed -= OnLogChanged;

    private static string LevelClass(LogLevel level) => level switch
    {
        LogLevel.Error   => "console-level-error",
        LogLevel.Warning => "console-level-warn",
        _                => "console-level-info",
    };

    // Short uppercase tag (INF/WAR/ERR). Culture-invariant, and never throws regardless of name length.
    private static string LevelTag(LogLevel level)
    {
        string s = level.ToString().ToUpperInvariant();
        return s.Length <= 3 ? s : s[..3];
    }
}
