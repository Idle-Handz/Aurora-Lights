<MudDialog>
    <DialogContent>
        <iframe title="Licenses and third-party notices"
                src="legal/index.html"
                sandbox=""
                style="width:100%;height:65vh;border:0;background:var(--mud-palette-background);">
        </iframe>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    private void Close() => MudDialog.Close();
}
