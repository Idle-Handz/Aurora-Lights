@page "/overview"
@inject PhaseZeroSessionWorkspaceService SessionWorkspace

<PageTitle>Web Workspace</PageTitle>

<div class="hero-card">
    <div class="hero-copy">
        <div class="hero-kicker">Aurora Reflections</div>
        <h1>Web workspace</h1>
        <p>
            Bring in Aurora XML packs and `.dnd5e` character files, browse the
            merged compendium, and work with a temporary web copy before exporting
            the updated character file.
        </p>
        <div class="hero-actions">
            <a class="action-link primary" href="/import">Import Session Content</a>
            <a class="action-link" href="/compendium">Browse Compendium</a>
            <a class="action-link" href="/">Open Characters</a>
            <a class="action-link" href="/workspace">Open Workspace</a>
        </div>
    </div>
    <div class="hero-panel">
        <div class="stat-label">Session Summary</div>
        @if (_workspace is null)
        {
            <div class="stat-value">Loading...</div>
        }
        else
        {
            <div class="summary-grid">
                <div class="summary-item">
                    <div class="summary-number">@_workspace.ImportedFiles.Count</div>
                    <div class="summary-caption">Imported files</div>
                </div>
                <div class="summary-item">
                    <div class="summary-number">@_workspace.Index.TotalElements</div>
                    <div class="summary-caption">Discovered elements</div>
                </div>
                <div class="summary-item">
                    <div class="summary-number">@_workspace.XmlFileCount</div>
                    <div class="summary-caption">XML overlays</div>
                </div>
                <div class="summary-item">
                    <div class="summary-number">@_workspace.CharacterFileCount</div>
                    <div class="summary-caption">Character files</div>
                </div>
            </div>
        }
    </div>
</div>

<section class="content-card">
    <h2>Available Here</h2>
    <ul class="feature-list">
        <li>Accepts `.xml`, `.zip`, and `.dnd5e` uploads.</li>
        <li>Merges bundled SRD content with imported XML content.</li>
        <li>Creates and edits characters inside a temporary web workspace.</li>
        <li>Exports updated `.dnd5e` files and generated PDFs.</li>
    </ul>
</section>

<section class="content-card">
    <h2>Workspace Notes</h2>
    <ul class="feature-list">
        <li>Imported files are temporary and are cleaned up automatically.</li>
        <li>Download edited characters before closing or refreshing the web session.</li>
        <li>Use the desktop app when you need a durable local character library.</li>
    </ul>
</section>

@code {
    private PhaseZeroSessionWorkspace? _workspace;

    protected override async Task OnInitializedAsync()
    {
        _workspace = await SessionWorkspace.GetWorkspaceAsync();
    }
}
