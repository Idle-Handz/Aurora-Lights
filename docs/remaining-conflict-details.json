  {
    "id": "ID_WOTC_XGTE_MAGIC_ITEM_STAFF_OF_FLOWERS",
    "name": "Staff of Flowers",
    "type": "Magic Item",
    "source": "Xanathar\u2019s Guide to Everything",
    "path": "core\\dungeon-masters-guide-2024\\items-staffs.xml",
    "info": "<info>\n\t\t<name>Staffs</name>\n\t\t<description>Magical Staffs from the Dungeon Master\u2019s Guide (2024)</description>\n\t\t<update version=\"0.0.2\">\n\t\t\t<file name=\"items-staffs.xml\" url=\"https://raw.githubusercontent.com/AuroraLegacy/elements/master/core/dungeon-masters-guide-2024/items/items-staffs.xml\" />\n\t\t</update>\n\t</info>\n\n\t",
