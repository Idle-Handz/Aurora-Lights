    "xml": "<element name=\"Adamantine Ammunition\" type=\"Magic Item\" source=\"Dungeon Master\u2019s Guide (2024)\" id=\"ID_WOTC_DMG24_MAGIC_ITEM_AMMUNITION_ADAMANTINE\">\n\t\t<description>\n\t\t\t<p>This piece of ammunition is made of adamantine, one of the hardest substances in existence. Whenever this weapon or piece of ammunition hits an object, the hit is a Critical Hit.</p>\n\t\t</description>\n\t\t<setters>\n\t\t\t<set name=\"keywords\">arrow, bolt, bullet</set>\n\t\t\t<set name=\"category\">Ammunition</set>\n\t\t\t<set name=\"type\" addition=\"Any Ammunition\">Weapon</set>\n\t\t\t<set name=\"rarity\">Uncommon</set>\n\t\t\t<set name=\"cost\" currency=\"gp\">400</set>\n\t\t\t<set name=\"name-format\">Adamantine {{parent}}</set>\n\t\t\t<set name=\"stackable\">true</set>\n\t\t</setters>\n\t</element>\n\n\t",
