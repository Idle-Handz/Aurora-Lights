@using MudBlazor

@* Match the MainLayout disclosure, including every action and the saved notice.
   Keep testing the expanded panel too: its wrapping must not hide shop results. *@
<details class="cloud-save-panel">
    <summary class="cloud-save-summary">
        <MudIcon Icon="@Icons.Material.Filled.Cloud" />
        <span class="cloud-save-status">Google Drive — Saved</span>
        <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Class="cloud-save-chevron" />
    </summary>
    <div class="cloud-save-details">
        <div class="d-flex align-center flex-wrap gap-2">
            <MudButton>Save to Drive</MudButton>
            <MudButton>Load Drive Save</MudButton>
            <MudButton>Disconnect character</MudButton>
            <MudButton>Recovery Files</MudButton>
        </div>
        <MudText Typo="Typo.body2">Saved to Google Drive.</MudText>
    </div>
</details>
