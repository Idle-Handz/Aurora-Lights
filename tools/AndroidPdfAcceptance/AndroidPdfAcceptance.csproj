<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <ApplicationId>com.auroralights.pdfacceptance</ApplicationId>
    <ApplicationTitle>Aurora PDF Acceptance</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <RunAOTCompilation>false</RunAOTCompilation>
    <PublishTrimmed>false</PublishTrimmed>
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
  </PropertyGroup>
  <ItemGroup>
    <AndroidEnvironment Include="../../Aurora.Reflections/Platforms/Android/gc.env" />
    <ProjectReference Include="../../Aurora.Logic/Aurora.Logic.csproj" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <PackageReference Include="PdfPig" Version="0.1.14" />
    <PackageReference Include="SkiaSharp.NativeAssets.Android" Version="4.152.0" />
    <Compile Include="../../Aurora.Tests/Tests/PdfExportAcceptanceTests.cs" Link="PdfExportAcceptanceTests.cs" />
    <Compile Include="../../Aurora.Tests/Tests/CharacterSheetFlatteningTests.cs" Link="CharacterSheetFlatteningTests.cs" />
    <Compile Include="../../Aurora.Tests/Tests/PortablePdfFontsTests.cs" Link="PortablePdfFontsTests.cs" />
    <Compile Include="../../Aurora.Tests/Tests/PdfExportFilesTests.cs" Link="PdfExportFilesTests.cs" />
    <Compile Include="../../Aurora.Reflections/Services/PdfExportFiles.cs" Link="PdfExportFiles.cs" />
    <Compile Include="../../Aurora.Tests/Helpers/TestApplicationContext.cs" Link="TestApplicationContext.cs" />
    <Using Include="Xunit" /><Using Include="FluentAssertions" />
  </ItemGroup>
</Project>
